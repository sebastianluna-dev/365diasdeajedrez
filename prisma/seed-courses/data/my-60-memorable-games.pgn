[Variant "Standard"]
[ECO "B57"]
[Opening "Sicilian Defense: Classical Variation, Sozin Attack"]
[StudyName "Mis 60 memorables partidas. Bobby Fisher"]
[ChapterName "13. Robert James Fischer - Svetozar Gligoric 1959"]
[ChapterURL "https://lichess.org/study/Wq1xlajv/MmsL0XrD"]
[Annotator "https://lichess.org/@/PeyaTheCrazy"]
