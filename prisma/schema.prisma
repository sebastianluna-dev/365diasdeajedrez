// Plataforma educativa — dominio de la app autenticada.
// Base de datos SEPARADA de Payload (Payload usa DATABASE_URI; esto usa
// PLATFORM_DATABASE_URL). Ninguna tabla de este schema convive con las del CMS.
//
// Decisiones fijadas por el diagrama conceptual v2:
// - El PGN es la fuente del contenido ajedrecístico (Lesson.pgn, Game.pgn).
//   No existen tablas por movimiento ni árboles relacionales de jugadas.
// - Sin enums de Prisma/Postgres: cada dominio restringido es una tabla
//   catálogo (code único y estable; la lógica de negocio compara codes,
//   nunca ids). Los valores se cargan por seed idempotente.
// - Claves compuestas para las tablas de progreso/intermedias.
//
// Restricciones que Prisma no puede expresar (añadidas a mano en la
// migración inicial como CHECK constraints — ver prisma/migrations):
// - GameDatabase: exactamente uno de (userId, courseId) con valor.
// - Position: exactamente uno de (userId, courseId) con valor
//   (los propietarios TEACHER apuntan por userId; Teacher es 1:1 con User).
// - ClassBlock: como máximo una referencia (gameId, lessonId, positionId).
// - UserStatDaily: índice único con NULLS NOT DISTINCT para que topicId NULL
//   no duplique filas.
// - TeacherStudent: índice único parcial teacher_student_one_active sobre
//   studentId WHERE endedAt IS NULL (un profesor activo por alumno).
// Reglas que se validan en la capa de servicios (imposibles en CHECK sin
// cruzar tablas): coherencia ownerType↔columna poblada, ClassBlock.kind↔campo
// usado, Lesson.initialFen nulo sólo cuando initialPositionType=STARTING_POSITION.

generator client {
  provider = "prisma-client"
  output   = "../lib/platform-db/generated"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Catálogos (reemplazan enums; upsert por code en el seed)
// ---------------------------------------------------------------------------

model CourseType {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  label    String
  order    Int     @default(0)
  isActive Boolean @default(true)

  courses Course[]
}

model CourseStatus {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  courses Course[]
}

model AuthorRole {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  courseAuthors CourseAuthor[]
}

model Level {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  label    String
  order    Int     @default(0)
  isActive Boolean @default(true)

  courseLevels CourseLevel[]
}

model PresentationMode {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  lessons Lesson[]
}

model InitialPositionType {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  lessons Lesson[]
}

/// Orientación del tablero. Catálogo compartido por Lesson, Position y
/// UserCourseSettings porque es el mismo concepto de dominio; AUTO sólo es
/// válido en UserCourseSettings (subconjuntos por contexto en
/// constants/platform/shared-codes.const.ts, validados por servicios).
model BoardOrientation {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  lessons            Lesson[]
  trainingLessons    Lesson[]             @relation("LessonTrainingColor")
  positions          Position[]
  userCourseSettings UserCourseSettings[]
}

model ExerciseMode {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  exercises TrainingExercise[]
}

/// Compartido por CourseProgress, ChapterProgress y LessonProgress.
model ProgressStatus {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  courseProgresses  CourseProgress[]
  chapterProgresses ChapterProgress[]
  lessonProgresses  LessonProgress[]
}

model AttemptResult {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  attempts TrainingAttempt[]
}

model AttemptContext {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  attempts TrainingAttempt[]
}

/// Propietario polimórfico. Compartido por GameDatabase (USER/COURSE) y
/// Position (USER/COURSE/TEACHER); la validez por tabla la aplican los
/// servicios — la integridad real vive en los CHECK XOR de la migración.
model OwnerType {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  gameDatabases GameDatabase[]
  positions     Position[]
}

model DatabaseKind {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  gameDatabases GameDatabase[]
}

model GameSource {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  games Game[]
}

/// Resultado de partida como catálogo (el spec prohíbe strings libres en
/// dominios restringidos). `label` lleva el token PGN: "1-0", "0-1",
/// "1/2-1/2", "*".
model GameResult {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  games Game[]
}

model ClassStatus {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  classes Class[]
}

model MeetingProvider {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  label    String
  order    Int     @default(0)
  isActive Boolean @default(true)

  classes Class[]
}

model ClassBlockKind {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  blocks ClassBlock[]
}

model TranscriptStatus {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  transcripts ClassTranscript[]
}

model ActivityType {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  activities UserActivity[]
}

model SubjectType {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  activities UserActivity[]
}

model StatMetric {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  dailyStats UserStatDaily[]
}

/// Catálogo de temas con jerarquía (sub-temas via parentId). Añadir un tema
/// nuevo es una fila, no una migración.
model Topic {
  id       Int    @id @default(autoincrement())
  code     String @unique
  label    String
  parentId Int?
  order    Int    @default(0)

  parent   Topic?  @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Topic[] @relation("TopicHierarchy")

  lessonTopics LessonTopic[]
  activities   UserActivity[]
  dailyStats   UserStatDaily[]
}

// ---------------------------------------------------------------------------
// Contenido: Course → Chapter → Lesson (la lección ES un PGN)
// ---------------------------------------------------------------------------

model Course {
  /// Numérico de 8 dígitos: va en la URL del alumno (`/cursos/00020212`).
  /// Lo pone la aplicación (lib/numeric-id.ts), no Prisma.
  id          String    @id
  name        String
  slug        String    @unique
  description String?
  cover       String?
  typeId      Int
  statusId    Int
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  type   CourseType   @relation(fields: [typeId], references: [id])
  status CourseStatus @relation(fields: [statusId], references: [id])

  chapters        Chapter[]
  courseAuthors   CourseAuthor[]
  courseLevels    CourseLevel[]
  progresses      CourseProgress[]
  settings        UserCourseSettings[]
  gameDatabases   GameDatabase[]
  positions       Position[]
}

model Author {
  id    String  @id @default(uuid())
  name  String
  slug  String  @unique
  bio   String?
  photo String?

  courseAuthors CourseAuthor[]
}

model CourseAuthor {
  courseId String
  authorId String
  roleId   Int
  order    Int    @default(0)

  course Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author Author     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  role   AuthorRole @relation(fields: [roleId], references: [id])

  @@id([courseId, authorId])
}

model CourseLevel {
  courseId String
  levelId  Int

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  level  Level  @relation(fields: [levelId], references: [id])

  @@id([courseId, levelId])
}

model Chapter {
  id                String  @id @default(uuid())
  courseId          String
  name              String
  description       String?
  order             Int
  /// Minutos estimados.
  estimatedDuration Int?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons         Lesson[]
  progresses      ChapterProgress[]
  trainerChapters UserTrainerChapter[]

  @@unique([courseId, order])
}

model Lesson {
  /// Numérico de 8 dígitos: va en la URL del alumno (`/lecciones/02482009`).
  id                    String    @id
  chapterId             String
  name                  String
  description           String?
  order                 Int
  /// Lección imprescindible del curso (marca editorial; el filtro es del alumno).
  isPriority            Boolean   @default(false)
  /// Minutos estimados.
  estimatedDuration     Int?
  presentationModeId    Int
  initialPositionTypeId Int
  /// Nulo cuando initialPositionType = STARTING_POSITION (regla de servicios).
  initialFen            String?
  orientationId         Int
  /// Fuente única del contenido: movimientos, variantes, comentarios, NAGs,
  /// [%cal]/[%csl] y [%diagram] viven dentro del PGN.
  pgn                   String    @db.Text
  pgnUpdatedAt          DateTime?
  /// La lección puede entrenarse de memoria en el Move Trainer. Al activarla se
  /// deriva un TrainingExercise con SU LÍNEA PRINCIPAL; las variantes siguen
  /// existiendo para el modo estudiar, pero el repaso no las evalúa.
  isTrainable           Boolean   @default(false)
  /// Bando que juega el ALUMNO al entrenar, cuando no es el que mueve primero.
  /// Nulo = el que mueva primero en la línea. Sirve para los repertorios de
  /// negras: en «1.e4 c6 2.d4 d5» el alumno debe responder c6 y d5, no jugar e4.
  /// Es distinto de `orientation`, que sólo decide cómo se ve el tablero.
  trainingColorId       Int?

  chapter             Chapter             @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  presentationMode    PresentationMode    @relation(fields: [presentationModeId], references: [id])
  initialPositionType InitialPositionType @relation(fields: [initialPositionTypeId], references: [id])
  orientation         BoardOrientation    @relation(fields: [orientationId], references: [id])
  trainingColor       BoardOrientation?   @relation("LessonTrainingColor", fields: [trainingColorId], references: [id])

  exercises        TrainingExercise[]
  trainings        UserLessonTraining[]
  progresses       LessonProgress[]
  lessonTopics     LessonTopic[]
  classBlocks      ClassBlock[]
  courseProgresses CourseProgress[]   @relation("CourseProgressLastLesson")

  @@unique([chapterId, order])
}

/// Declara un tramo entrenable del PGN. `path` usa rutas punteadas de índices
/// de hijos desde la raíz ("0.0.1.0"); startFen + line van congelados para que
/// el entrenador no dependa del parseo ni se rompa si el autor edita el PGN.
model TrainingExercise {
  id         String    @id @default(uuid())
  lessonId   String
  order      Int
  modeId     Int
  path       String
  startPly   Int
  endPly     Int
  startFen   String
  /// SAN del tramo, separado por espacios, congelado al publicar.
  line       String
  /// Momento en que se congelaron startFen y line. El ejercicio queda «stale»
  /// cuando Lesson.pgnUpdatedAt es posterior: sigue siendo entrenable (la copia
  /// congelada es autosuficiente) pero puede no reflejar ya la lección.
  frozenAt   DateTime?
  promptText String?
  /// Lo generó el sistema desde la línea principal de la lección, no el staff.
  /// Se regenera al editar el PGN y desaparece si la lección deja de ser
  /// entrenable; los ejercicios creados a mano no se tocan nunca.
  isDerived  Boolean   @default(false)

  lesson Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  mode   ExerciseMode @relation(fields: [modeId], references: [id])

  attempts TrainingAttempt[]

  @@unique([lessonId, order])
}

model LessonTopic {
  lessonId String
  topicId  Int

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([lessonId, topicId])
}

// ---------------------------------------------------------------------------
// Usuario, progreso y configuración de estudio
// ---------------------------------------------------------------------------

/// Identidad del alumno. Es también la credencial: la plataforma no delega la
/// autenticación en Payload (que sólo gestiona el CMS del sitio público) ni en
/// un proveedor externo, así que el hash de la contraseña vive aquí.
model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String
  createdAt   DateTime @default(now())

  /// Hash scrypt con sus parámetros embebidos (ver lib/platform-auth/password.ts).
  /// null = cuenta dada de alta sin credencial todavía: no puede iniciar sesión.
  passwordHash      String?
  passwordUpdatedAt DateTime?
  lastLoginAt       DateTime?

  sessions          Session[]
  teacher           Teacher?
  staff             Staff?
  courseProgresses  CourseProgress[]
  chapterProgresses ChapterProgress[]
  lessonProgresses  LessonProgress[]
  attempts          TrainingAttempt[]
  lessonTrainings   UserLessonTraining[]
  courseSettings    UserCourseSettings[]
  trainerChapters   UserTrainerChapter[]
  gameDatabases     GameDatabase[]
  positions         Position[]
  classParticipants ClassParticipant[]
  activities        UserActivity[]
  dailyStats        UserStatDaily[]

  /// Asignaciones en las que este usuario es el alumno.
  studentAssignments TeacherStudent[] @relation("StudentAssignments")
  /// Asignaciones que este usuario (staff) hizo: auditoría ligera.
  assignmentsMade    TeacherStudent[] @relation("AssignmentsMade")
}

/// Sesión iniciada. El token que viaja en la cookie es un valor aleatorio
/// opaco del que sólo se guarda su SHA-256: si alguien lee esta tabla no puede
/// suplantar a nadie. La caducidad de verdad es `expiresAt` (la cookie sólo
/// transporta el token), de modo que cerrar sesión o revocarla surte efecto
/// inmediato sin depender del navegador.
model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  /// Última vez que se usó; sirve para la renovación deslizante y para
  /// distinguir sesiones vivas de las abandonadas.
  lastSeenAt DateTime @default(now())
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model CourseProgress {
  userId       String
  courseId     String
  statusId     Int
  startedAt    DateTime?
  completedAt  DateTime?
  /// Punto de retorno de «continuar estudiando».
  lastLessonId String?

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status     ProgressStatus @relation(fields: [statusId], references: [id])
  lastLesson Lesson?        @relation("CourseProgressLastLesson", fields: [lastLessonId], references: [id], onDelete: SetNull)

  @@id([userId, courseId])
}

model ChapterProgress {
  userId       String
  chapterId    String
  statusId     Int
  startedAt    DateTime?
  completedAt  DateTime?
  quizPassedAt DateTime?

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  status  ProgressStatus @relation(fields: [statusId], references: [id])

  @@id([userId, chapterId])
}

model LessonProgress {
  userId      String
  lessonId    String
  statusId    Int
  startedAt   DateTime?
  completedAt DateTime?

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status ProgressStatus @relation(fields: [statusId], references: [id])

  @@id([userId, lessonId])
}

/// Histórico append-only; nunca se actualiza.
model TrainingAttempt {
  id            String   @id @default(uuid())
  userId        String
  exerciseId    String
  resultId      Int
  mistakes      Int      @default(0)
  durationMs    Int?
  contextId     Int
  /// Jugadas del alumno que pedía la línea.
  requiredMoves Int      @default(0)
  /// Acertadas a la primera. `mistakes` cuenta los fallos, que pueden repetirse
  /// sobre la misma jugada, así que correctMoves NO es requiredMoves - mistakes.
  correctMoves  Int      @default(0)
  /// Hasta qué ply llegó. Es el DENOMINADOR para saber cuántas veces se pasó por
  /// una posición: sin esto, los fallos guardados no se pueden convertir en un
  /// porcentaje de aciertos.
  reachedPly    Int      @default(0)
  hintsUsed     Int      @default(0)
  /// Toda la secuencia a la primera y sin pistas. Se guarda aparte de la
  /// precisión: se puede acertar el 92 % y no ser un repaso perfecto.
  isPerfect     Boolean  @default(false)
  createdAt     DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise TrainingExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  result   AttemptResult    @relation(fields: [resultId], references: [id])
  context  AttemptContext   @relation(fields: [contextId], references: [id])

  mistakeDetails TrainingMistake[]

  @@index([userId, createdAt])
  @@index([exerciseId])
}

/// Una fila POR JUGADA FALLADA, no por jugada. Un alumno que acierta todo no
/// escribe ninguna, así que la tabla crece con los errores y no con el uso.
///
/// La posición se identifica por el hash de su FEN (lib/chess/position-hash.ts)
/// y no por el número de jugada: así el dato sobrevive a que se edite el PGN, y
/// agrupa la misma posición alcanzada por transposición desde otra lección.
model TrainingMistake {
  id           String   @id @default(uuid())
  attemptId    String
  positionHash String
  fen          String
  expectedSan  String
  playedSan    String
  /// Ply dentro de la línea, para poder cruzarlo con `reachedPly`.
  ply          Int
  usedHint     Boolean  @default(false)
  createdAt    DateTime @default(now())

  attempt TrainingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([positionHash])
}

/// Estado actual del alumno con una lección entrenable, separado del historial
/// de intentos para poder saber de un vistazo qué toca repasar.
///
/// Cuelga de (userId, lessonId) y NO de la ruta punteada dentro del PGN: esas
/// rutas se reordenan al promover una variante, así que atar el progreso a
/// ellas lo perdería en la primera edición. La lección es la identidad estable.
model UserLessonTraining {
  userId              String
  lessonId            String
  totalAttempts       Int       @default(0)
  perfectAttempts     Int       @default(0)
  /// Porcentaje 0-100 del último intento y del mejor.
  lastAccuracy        Int       @default(0)
  bestAccuracy        Int       @default(0)
  /// Repasos perfectos seguidos: es lo que sube el peldaño de la escalera.
  consecutivePerfect  Int       @default(0)
  currentIntervalDays Int       @default(0)
  /// Peldaño actual, para no recalcularlo desde el intervalo.
  masteryLevel        Int       @default(0)
  lastReviewedAt      DateTime?
  nextReviewAt        DateTime?
  updatedAt           DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([userId, nextReviewAt])
}

/// Una fila por usuario y curso, creada al primer cambio. Su ausencia
/// significa «valores por defecto»: no se crea al inscribirse.
model UserCourseSettings {
  userId             String
  courseId           String
  onlyPriorityLessons Boolean  @default(false)
  boardOrientationId Int
  trainingAfterLesson Boolean  @default(true)
  updatedAt          DateTime @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  boardOrientation BoardOrientation @relation(fields: [boardOrientationId], references: [id])

  @@id([userId, courseId])
}

/// Capítulos que el usuario eligió entrenar de forma recurrente.
model UserTrainerChapter {
  userId    String
  chapterId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([userId, chapterId])
}

// ---------------------------------------------------------------------------
// Bases de datos de partidas («Mis estudios» en la interfaz)
// ---------------------------------------------------------------------------

/// Una tabla, dos propietarios: usuario (bases privadas) o curso (bases del
/// contenido publicado). CHECK XOR (userId, courseId) en la migración.
model GameDatabase {
  /// Corto porque va en la URL: `/estudios/aB3xK9pQ`. Lo genera Prisma en el
  /// cliente, igual que `uuid()`, así que la columna sigue siendo TEXT.
  id          String   @id @default(nanoid(8))
  ownerTypeId Int
  userId      String?
  courseId    String?
  name        String
  description String?
  kindId      Int
  /// La base creada al registrarse.
  isDefault   Boolean  @default(false)
  /// Orden dentro del curso.
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerType OwnerType    @relation(fields: [ownerTypeId], references: [id])
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  kind      DatabaseKind @relation(fields: [kindId], references: [id])

  games         Game[]
  gamePositions GamePosition[]

  @@index([userId])
  @@index([courseId])
}

/// Cabeceras en columnas (listar/ordenar/filtrar sin parsear); el PGN sigue
/// siendo la fuente del contenido.
model Game {
  /// Corto por el mismo motivo que el del estudio: los dos van en la URL.
  id         String    @id @default(nanoid(8))
  databaseId String
  /// Cómo se distingue esta partida DENTRO de su estudio («Capítulo 1»).
  /// Anulable a propósito: una partida se identifica por sus jugadores, y sólo
  /// las creadas en blanco necesitan un nombre para no ser todas iguales. Las
  /// importadas de un PGN se quedan a NULL y se siguen mostrando por su pareja.
  title      String?
  white      String
  black      String
  whiteElo   Int?
  blackElo   Int?
  resultId   Int
  playedAt   DateTime? @db.Date
  event      String?
  site       String?
  round      String?
  eco        String?
  /// Nulo si la partida empieza en la posición inicial.
  initialFen String?
  pgn        String    @db.Text
  /// Etiquetas libres del usuario.
  tags       Json?
  sourceId   Int
  /// Sólo con sentido en bases de usuario.
  isOwnGame  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  database GameDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  result   GameResult   @relation(fields: [resultId], references: [id])
  source   GameSource   @relation(fields: [sourceId], references: [id])

  classBlocks ClassBlock[]
  positions   GamePosition[]

  @@index([databaseId])
}

/// Índice de posiciones: una fila por cada posición por la que pasó la partida.
/// Es lo que permite buscar «qué partidas llegaron aquí» por POSICIÓN y no por
/// secuencia de jugadas, de modo que las transposiciones cuentan como
/// coincidencia. Se genera al importar (ver services/game-positions) y se
/// regenera entera si el PGN cambia; nunca se edita a mano.
///
/// Sin columna `fen` a propósito: son ~80 filas por partida y el FEN completo
/// no lo lee nadie —quien busca ya aporta el suyo y el de cualquier ply se
/// recupera reproduciendo el PGN—, así que sólo engordaría la tabla.
model GamePosition {
  id     String @id @default(uuid())
  gameId String
  /// Denormalizado desde Game: deja filtrar por propietario y origen sin unir
  /// con Game en la consulta caliente del explorador.
  databaseId String
  /// Medias jugadas desde el inicio; 0 es la posición de partida.
  ply Int
  /// SHA-256 del FEN normalizado (ver lib/chess/position-hash).
  positionHash String
  /// Jugada hecha DESDE esta posición; nula en la última. De aquí salen las
  /// estadísticas de continuaciones.
  nextMoveSan String?
  nextMoveUci String?

  game     Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  database GameDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  /// Una posición repetida en la misma partida da varias filas, una por ply:
  /// contar partidas exige contar gameId distintos, nunca filas.
  @@unique([gameId, ply])
  @@index([positionHash])
  @@index([positionHash, databaseId])
  @@index([positionHash, nextMoveUci])
}

// ---------------------------------------------------------------------------
// Clases y profesores
// ---------------------------------------------------------------------------

/// Rol sobre User: el panel del profesor se abre si existe esta fila.
/// Un profesor nunca se borra (rompería clases y asignaciones históricas): se
/// desactiva con isActive, y entonces deja de poder entrar a /teacher y de
/// admitir asignaciones nuevas.
model Teacher {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String
  title       String?
  bio         String?
  photo       String?
  timezone    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  classes  Class[]
  students TeacherStudent[]
}

/// Asignación profesor↔alumno, independiente de las clases: sin ella un alumno
/// que aún no tiene clases sería invisible para su profesor. endedAt = null ⇒
/// activa. Reasignar CIERRA la fila y crea otra: el historial nunca se borra.
/// La regla «un profesor activo por alumno» la impone el índice único parcial
/// teacher_student_one_active (SQL manual en la migración); para permitir
/// varios profesores en el futuro basta con eliminar ese índice, sin tocar el
/// modelo. Sin catálogo de estado: activa/terminada se deriva de endedAt.
model TeacherStudent {
  id         String    @id @default(uuid())
  teacherId  String
  studentId  String
  assignedAt DateTime  @default(now())
  endedAt    DateTime?
  /// User del staff que hizo la asignación (auditoría ligera).
  assignedBy String?
  note       String?

  teacher  Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student  User    @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  assigner User?   @relation("AssignmentsMade", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@index([teacherId, endedAt])
  @@index([studentId])
}

/// Rol Administrador/Editor de la PLATAFORMA (la fila existe = tiene el rol),
/// mismo patrón que Teacher. NO confundir con los roles admin/editor de
/// Payload, que pertenecen al CMS del sitio público y viven en otra base de
/// datos: no se mezclan ni se reutilizan. Si algún día se separan admin y
/// editor, se añade aquí un roleId + catálogo StaffRole, sin tocar User.
model Staff {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Class {
  id                    String    @id @default(uuid())
  teacherId             String
  title                 String
  description           String?
  /// Fecha y hora de la clase (UTC).
  scheduledAt           DateTime
  durationMin           Int
  statusId              Int
  meetingProviderId     Int?
  meetingUrl            String?
  /// El enlace sólo se devuelve al cliente cuando now >= meetingUrlVisibleFrom.
  meetingUrlVisibleFrom DateTime?
  recordingUrl          String?
  summary               String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  teacher         Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  status          ClassStatus      @relation(fields: [statusId], references: [id])
  meetingProvider MeetingProvider? @relation(fields: [meetingProviderId], references: [id])

  participants ClassParticipant[]
  blocks       ClassBlock[]
  transcript   ClassTranscript?

  @@index([scheduledAt])
  @@index([teacherId])
}

model ClassParticipant {
  classId    String
  userId     String
  paidAt     DateTime?
  amount     Decimal?  @db.Decimal(10, 2)
  currency   String?
  paymentRef String?
  attended   Boolean   @default(false)
  joinedAt   DateTime?
  createdAt  DateTime  @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
  /// «Las clases de este alumno» desde el panel del profesor y del staff: la
  /// clave compuesta empieza por classId y no sirve para ese acceso.
  @@index([userId])
}

/// Contenido ordenado de la clase. Un bloque usa el campo de su kind y las
/// referencias son punteros, nunca copias. CHECK «máx. una referencia» en la
/// migración. `movePath` usa la misma ruta punteada que TrainingExercise.path.
model ClassBlock {
  id         String  @id @default(uuid())
  classId    String
  order      Int
  kindId     Int
  text       String? @db.Text
  videoUrl   String?
  gameId     String?
  lessonId   String?
  positionId String?
  movePath   String?
  caption    String?

  class    Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  kind     ClassBlockKind @relation(fields: [kindId], references: [id])
  game     Game?          @relation(fields: [gameId], references: [id], onDelete: SetNull)
  lesson   Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  position Position?      @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@unique([classId, order])
}

model ClassTranscript {
  classId    String   @id
  provider   String?
  language   String?
  statusId   Int
  text       String?  @db.Text
  /// [{ startMs, speaker, text }]
  segments   Json?
  durationMs Int?
  createdAt  DateTime @default(now())

  class  Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  status TranscriptStatus @relation(fields: [statusId], references: [id])
}

/// Diagrama guardado y reutilizable. CHECK XOR (userId, courseId) en la
/// migración; los propietarios TEACHER usan userId (Teacher es 1:1 con User).
model Position {
  id            String   @id @default(uuid())
  ownerTypeId   Int
  userId        String?
  courseId      String?
  title         String?
  fen           String
  orientationId Int
  /// json de flechas [{ orig, dest, color }]
  arrows        Json?
  /// json de casillas resaltadas [{ square, color }]
  highlights    Json?
  createdAt     DateTime @default(now())

  ownerType   OwnerType        @relation(fields: [ownerTypeId], references: [id])
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orientation BoardOrientation @relation(fields: [orientationId], references: [id])

  classBlocks ClassBlock[]

  @@index([userId])
  @@index([courseId])
}

// ---------------------------------------------------------------------------
// Actividad y estadísticas
// ---------------------------------------------------------------------------

/// Registro append-only de cada hecho del alumno: fuente de verdad de todas
/// las estadísticas. Nunca se actualiza ni se borra.
model UserActivity {
  id            String   @id @default(uuid())
  userId        String
  typeId        Int
  subjectTypeId Int
  /// uuid del sujeto; polimórfico a propósito, sin FK.
  subjectId     String
  topicId       Int?
  occurredAt    DateTime @default(now())
  meta          Json?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ActivityType @relation(fields: [typeId], references: [id])
  subjectType SubjectType  @relation(fields: [subjectTypeId], references: [id])
  topic       Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
}

/// Agregado derivado por usuario/día/métrica/tema; reconstruible entero desde
/// UserActivity. topicId NULL = total. En v1 el dashboard calcula directo de
/// UserActivity; esta tabla queda lista para el rollup. El índice único se
/// reemplaza en la migración por NULLS NOT DISTINCT.
model UserStatDaily {
  id       String   @id @default(uuid())
  userId   String
  day      DateTime @db.Date
  metricId Int
  topicId  Int?
  value    Int      @default(0)

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric StatMetric @relation(fields: [metricId], references: [id])
  topic  Topic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([userId, day, metricId, topicId])
}
