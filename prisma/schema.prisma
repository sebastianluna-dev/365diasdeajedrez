// Learning platform — domain of the authenticated app.
// Database SEPARATE from Payload's (Payload uses DATABASE_URI; this uses
// PLATFORM_DATABASE_URL). No table of this schema lives with the CMS's.
//
// Decisions fixed by the v2 conceptual diagram:
// - The PGN is the source of the chess content (Lesson.pgn, Game.pgn).
//   There are no per-move tables nor relational move trees.
// - No Prisma/Postgres enums: every restricted domain is a catalog table
//   (unique and stable code; the business logic compares codes, never ids).
//   The values are loaded by an idempotent seed.
// - Composite keys for the progress/join tables.
//
// Constraints Prisma cannot express (added by hand in the initial migration as
// CHECK constraints — see prisma/migrations):
// - GameDatabase: exactly one of (userId, courseId) with a value.
// - Position: exactly one of (userId, courseId) with a value
//   (TEACHER owners point through userId; Teacher is 1:1 with User).
// - ClassBlock: at most one reference (gameId, lessonId, positionId).
// - UserStatDaily: unique index with NULLS NOT DISTINCT so a NULL topicId does
//   not duplicate rows.
// - TeacherStudent: partial unique index teacher_student_one_active over
//   studentId WHERE endedAt IS NULL (one active teacher per student).
// Rules validated in the services layer (impossible in a CHECK without
// crossing tables): ownerType↔populated column coherence, ClassBlock.kind↔field
// used.

generator client {
  provider        = "prisma-client"
  output          = "../lib/platform-db/generated"
  // `relationLoadStrategy: "join"`: one SQL query per read instead of one per
  // included relation, which matters against a remote database (see docs/
  // architecture/data-access).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Catalogs (they replace enums; upserted by code in the seed)
// ---------------------------------------------------------------------------

model CourseType {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  label    String
  order    Int     @default(0)
  isActive Boolean @default(true)

  courses Course[]
}

model CourseStatus {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  courses Course[]
}

model AuthorRole {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  courseAuthors CourseAuthor[]
}

/// Role of a chapter or of a lesson within what contains it: to open or to
/// close. The normal ones have NO row here — their `roleId` is null — which is
/// what makes it possible to require "at most one of each" with a unique index
/// over (parent, role) without the normal ones clashing with each other.
model ContentRole {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  chapters Chapter[]
  lessons  Lesson[]
}

model Level {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  label    String
  order    Int     @default(0)
  isActive Boolean @default(true)

  courseLevels CourseLevel[]
}

/// Board orientation. Catalog shared by Lesson, Position and
/// UserCourseSettings because it is the same domain concept; AUTO is only valid
/// in UserCourseSettings (subsets by context in
/// constants/platform/shared-codes.const.ts, validated by the services).
model BoardOrientation {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  lessons            Lesson[]
  trainingLessons    Lesson[]             @relation("LessonTrainingColor")
  positions          Position[]
  userCourseSettings UserCourseSettings[]
}

model ExerciseMode {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  exercises TrainingExercise[]
}

/// Shared by CourseProgress, ChapterProgress and LessonProgress.
model ProgressStatus {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  courseProgresses  CourseProgress[]
  chapterProgresses ChapterProgress[]
  lessonProgresses  LessonProgress[]
}

model AttemptResult {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  attempts TrainingAttempt[]
}

model AttemptContext {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  attempts TrainingAttempt[]
}

/// Polymorphic owner. Shared by GameDatabase (USER/COURSE) and Position
/// (USER/COURSE/TEACHER); validity per table is applied by the services — the
/// real integrity lives in the migration's XOR CHECKs.
model OwnerType {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  gameDatabases GameDatabase[]
  positions     Position[]
}

model DatabaseKind {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  gameDatabases GameDatabase[]
}

model GameSource {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  games Game[]
}

/// Game result as a catalog (the spec forbids free strings in restricted
/// domains). `label` carries the PGN token: "1-0", "0-1", "1/2-1/2", "*".
model GameResult {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  games Game[]
}

model ClassStatus {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  classes Class[]
}

model MeetingProvider {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  label    String
  order    Int     @default(0)
  isActive Boolean @default(true)

  classes Class[]
}

model ClassBlockKind {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  blocks ClassBlock[]
}

model TranscriptStatus {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  transcripts ClassTranscript[]
}

model ActivityType {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  activities UserActivity[]
}

model SubjectType {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  activities UserActivity[]
}

model StatMetric {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  dailyStats UserStatDaily[]
}

/// Topic catalog with hierarchy (sub-topics via parentId). Adding a new topic is
/// a row, not a migration.
model Topic {
  id       Int    @id @default(autoincrement())
  code     String @unique
  label    String
  parentId Int?
  order    Int    @default(0)

  parent   Topic?  @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Topic[] @relation("TopicHierarchy")

  lessonTopics LessonTopic[]
  activities   UserActivity[]
  dailyStats   UserStatDaily[]
}

// ---------------------------------------------------------------------------
// Content: Course → Chapter → Lesson (the lesson IS a PGN)
// ---------------------------------------------------------------------------

model Course {
  /// 8-digit numeric: it goes in the student's URL (`/cursos/00020212`).
  /// The application sets it (lib/numeric-id.ts), not Prisma.
  id          String    @id
  name        String
  slug        String    @unique
  description String?
  cover       String?
  typeId      Int
  statusId    Int
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  type   CourseType   @relation(fields: [typeId], references: [id])
  status CourseStatus @relation(fields: [statusId], references: [id])

  chapters      Chapter[]
  courseAuthors CourseAuthor[]
  courseLevels  CourseLevel[]
  progresses    CourseProgress[]
  settings      UserCourseSettings[]
  gameDatabases GameDatabase[]
  positions     Position[]
}

model Author {
  id    String  @id @default(uuid())
  name  String
  slug  String  @unique
  bio   String?
  photo String?

  courseAuthors CourseAuthor[]
}

model CourseAuthor {
  courseId String
  authorId String
  roleId   Int
  order    Int    @default(0)

  course Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author Author     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  role   AuthorRole @relation(fields: [roleId], references: [id])

  @@id([courseId, authorId])
}

model CourseLevel {
  courseId String
  levelId  Int

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  level  Level  @relation(fields: [levelId], references: [id])

  @@id([courseId, levelId])
}

model Chapter {
  id                String  @id @default(uuid())
  courseId          String
  name              String
  description       String?
  order             Int
  /// Introduction or closing of the course; null in normal chapters, which are
  /// the majority. At most one of each per course (partial unique index).
  roleId            Int?
  /// Estimated minutes.
  estimatedDuration Int?

  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  role   ContentRole? @relation(fields: [roleId], references: [id])

  lessons         Lesson[]
  progresses      ChapterProgress[]
  trainerChapters UserTrainerChapter[]
  /// Its game collection; at most one (see GameDatabase's index).
  gameDatabases   GameDatabase[]

  @@unique([courseId, order])
  /// At most one introduction and one closing per course. The normal ones have a
  /// null `roleId` and NULL does not clash with NULL, so they stay out of the index.
  @@unique([courseId, roleId])
}

model Lesson {
  /// 8-digit numeric: it goes in the student's URL (`/lecciones/02482009`).
  id                String    @id
  chapterId         String
  name              String
  description       String?
  order             Int
  /// Essential lesson of the course (editorial mark; the filter is the student's).
  isPriority        Boolean   @default(false)
  /// Introduction or closing of the chapter; null in normal lessons.
  roleId            Int?
  /// Estimated minutes.
  estimatedDuration Int?
  orientationId     Int
  /// Game of the course collection the content comes from.
  ///
  /// When it is set IT RULES: the lesson's content is that game's PGN, so that
  /// fixing it fixes every lesson that uses it. When it is null `pgn` rules, which
  /// is how lessons were born and how the ones that reference nothing still work.
  ///
  /// Which one rules is resolved in ONE single place: `lessonPgnOf`
  /// (services/shared/lesson-pgn.ts). Nobody should read `pgn` on their own.
  gameId            String?
  /// The lesson's own content. Inert while there is a `gameId`; it is kept and not
  /// deleted on linking, so that unlinking returns the lesson to what it had.
  pgn               String    @db.Text
  /// When `pgn` last changed. It is what marks as stale the exercises frozen
  /// before the change.
  pgnUpdatedAt      DateTime?
  /// The lesson can be trained from memory in the Move Trainer. Enabling it
  /// derives a TrainingExercise with ITS MAIN LINE; the variations go on existing
  /// for study mode, but the review does not evaluate them.
  isTrainable       Boolean   @default(false)
  /// Side the STUDENT plays when training, when it is not the one that moves
  /// first. Null = whoever moves first in the line. It serves black repertoires:
  /// in "1.e4 c6 2.d4 d5" the student must answer c6 and d5, not play e4.
  /// It is different from `orientation`, which only decides how the board is seen.
  trainingColorId   Int?

  chapter       Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  role          ContentRole?      @relation(fields: [roleId], references: [id])
  /// SetNull and not Cascade: if someone deletes the game from the collection, the
  /// lesson goes on existing — with its name, its topics and its progress — and is
  /// left without content until another one is linked to it.
  game          Game?             @relation(fields: [gameId], references: [id], onDelete: SetNull)
  orientation   BoardOrientation  @relation(fields: [orientationId], references: [id])
  trainingColor BoardOrientation? @relation("LessonTrainingColor", fields: [trainingColorId], references: [id])

  exercises        TrainingExercise[]
  trainings        UserLessonTraining[]
  progresses       LessonProgress[]
  lessonTopics     LessonTopic[]
  classBlocks      ClassBlock[]
  courseProgresses CourseProgress[]     @relation("CourseProgressLastLesson")

  @@unique([chapterId, order])
  /// At most one introduction and one closing per chapter; see Chapter.
  @@unique([chapterId, roleId])
  @@index([gameId])
}

/// Declares a trainable segment of the PGN. `path` uses dotted paths of child
/// indexes from the root ("0.0.1.0"); startFen + line are frozen so the trainer
/// does not depend on parsing nor break if the author edits the PGN.
model TrainingExercise {
  id         String    @id @default(uuid())
  lessonId   String
  order      Int
  modeId     Int
  path       String
  startPly   Int
  endPly     Int
  startFen   String
  /// SAN of the segment, space-separated, frozen on publishing.
  line       String
  /// Moment startFen and line were frozen. The exercise becomes "stale" when
  /// Lesson.pgnUpdatedAt is later: it is still trainable (the frozen copy is
  /// self-sufficient) but it may no longer reflect the lesson.
  frozenAt   DateTime?
  promptText String?
  /// The system generated it from the lesson's main line, not the staff. It is
  /// regenerated when the PGN is edited and disappears if the lesson stops being
  /// trainable; hand-made exercises are never touched.
  isDerived  Boolean   @default(false)

  lesson Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  mode   ExerciseMode @relation(fields: [modeId], references: [id])

  attempts TrainingAttempt[]

  @@unique([lessonId, order])
}

model LessonTopic {
  lessonId String
  topicId  Int

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([lessonId, topicId])
}

// ---------------------------------------------------------------------------
// User, progress and study settings
// ---------------------------------------------------------------------------

/// The student's identity. It is also the credential: the platform delegates
/// authentication neither to Payload (which only manages the public site's CMS)
/// nor to an external provider, so the password hash lives here.
model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String
  createdAt   DateTime @default(now())

  /// scrypt hash with its parameters embedded (see lib/platform-auth/password.ts).
  /// null = account created without a credential yet: it cannot log in.
  passwordHash      String?
  passwordUpdatedAt DateTime?
  lastLoginAt       DateTime?

  /// Minutes of study the student sets themselves per day. A column and not a
  /// settings table because today it is the only setting that does not hang from a
  /// course (the ones that do live in UserCourseSettings); if more appear, they
  /// move together.
  dailyGoalMinutes Int @default(30)

  sessions          Session[]
  teacher           Teacher?
  staff             Staff?
  courseProgresses  CourseProgress[]
  chapterProgresses ChapterProgress[]
  lessonProgresses  LessonProgress[]
  attempts          TrainingAttempt[]
  lessonTrainings   UserLessonTraining[]
  courseSettings    UserCourseSettings[]
  trainerChapters   UserTrainerChapter[]
  gameDatabases     GameDatabase[]
  /// Collections that have been shared with them.
  studyShares       StudyShare[]
  positions         Position[]
  classParticipants ClassParticipant[]
  activities        UserActivity[]
  dailyStats        UserStatDaily[]

  /// Assignments in which this user is the student.
  studentAssignments TeacherStudent[] @relation("StudentAssignments")
  /// Assignments this user (staff) made: lightweight auditing.
  assignmentsMade    TeacherStudent[] @relation("AssignmentsMade")
}

/// Open session. The token travelling in the cookie is an opaque random value of
/// which only its SHA-256 is stored: if someone reads this table they cannot
/// impersonate anyone. The real expiry is `expiresAt` (the cookie only
/// transports the token), so logging out or revoking takes effect immediately
/// without depending on the browser.
model Session {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  /// Last time it was used; it serves the sliding renewal and telling live
  /// sessions from abandoned ones.
  lastSeenAt DateTime @default(now())
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Rate-limit windows for the server actions.
///
/// It lives in the database and not in the process's memory because the ceiling
/// has to be ONE for the whole app: with the counter in memory, two instances
/// behind a load balancer give twice the attempts — and in serverless every cold
/// start begins at zero, which is exactly what a brute-force attack needs.
///
/// `key` identifies the subject and the operation (`login:ana@ejemplo.com`,
/// `<userId>:import`). The rows expire on their own: they are deleted when they
/// run out, with no need for a separate process to collect them.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model CourseProgress {
  userId       String
  courseId     String
  statusId     Int
  startedAt    DateTime?
  completedAt  DateTime?
  /// Return point of "continue studying".
  lastLessonId String?

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status     ProgressStatus @relation(fields: [statusId], references: [id])
  lastLesson Lesson?        @relation("CourseProgressLastLesson", fields: [lastLessonId], references: [id], onDelete: SetNull)

  @@id([userId, courseId])
}

model ChapterProgress {
  userId       String
  chapterId    String
  statusId     Int
  startedAt    DateTime?
  completedAt  DateTime?
  quizPassedAt DateTime?

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  status  ProgressStatus @relation(fields: [statusId], references: [id])

  @@id([userId, chapterId])
}

model LessonProgress {
  userId      String
  lessonId    String
  statusId    Int
  startedAt   DateTime?
  completedAt DateTime?

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status ProgressStatus @relation(fields: [statusId], references: [id])

  @@id([userId, lessonId])
}

/// Append-only history; it is never updated.
model TrainingAttempt {
  id            String   @id @default(uuid())
  userId        String
  exerciseId    String
  resultId      Int
  mistakes      Int      @default(0)
  durationMs    Int?
  contextId     Int
  /// Moves of the student the line asked for.
  requiredMoves Int      @default(0)
  /// Got right first time. `mistakes` counts the failures, which can repeat on the
  /// same move, so correctMoves is NOT requiredMoves - mistakes.
  correctMoves  Int      @default(0)
  /// How far in plies they got. It is the DENOMINATOR for knowing how many times a
  /// position was passed through: without this, the stored mistakes cannot be
  /// turned into a percentage of successes.
  reachedPly    Int      @default(0)
  hintsUsed     Int      @default(0)
  /// The whole sequence first time and without hints. It is stored apart from the
  /// accuracy: one can get 92 % right and not have a perfect review.
  isPerfect     Boolean  @default(false)
  createdAt     DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise TrainingExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  result   AttemptResult    @relation(fields: [resultId], references: [id])
  context  AttemptContext   @relation(fields: [contextId], references: [id])

  mistakeDetails TrainingMistake[]

  @@index([userId, createdAt])
  @@index([exerciseId])
}

/// One row PER FAILED MOVE, not per move. A student who gets everything right
/// writes none, so the table grows with the mistakes and not with the usage.
///
/// The position is identified by the hash of its FEN (lib/chess/position-hash.ts)
/// and not by the move number: that way the data survives the PGN being edited,
/// and it groups the same position reached by transposition from another lesson.
model TrainingMistake {
  id           String   @id @default(uuid())
  attemptId    String
  positionHash String
  fen          String
  expectedSan  String
  playedSan    String
  /// Ply within the line, so it can be crossed with `reachedPly`.
  ply          Int
  usedHint     Boolean  @default(false)
  createdAt    DateTime @default(now())

  attempt TrainingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([positionHash])
}

/// Current state of the student with a trainable lesson, kept apart from the
/// attempt history so that what is due for review can be known at a glance.
///
/// It hangs from (userId, lessonId) and NOT from the dotted path within the PGN:
/// those paths are reordered when a variation is promoted, so tying the progress
/// to them would lose it on the first edit. The lesson is the stable identity.
model UserLessonTraining {
  userId              String
  lessonId            String
  totalAttempts       Int       @default(0)
  perfectAttempts     Int       @default(0)
  /// Percentage 0-100 of the last attempt and of the best one.
  lastAccuracy        Int       @default(0)
  bestAccuracy        Int       @default(0)
  /// Consecutive perfect reviews: it is what climbs the ladder's rung.
  consecutivePerfect  Int       @default(0)
  currentIntervalDays Int       @default(0)
  /// Current rung, so as not to recompute it from the interval.
  masteryLevel        Int       @default(0)
  lastReviewedAt      DateTime?
  nextReviewAt        DateTime?
  updatedAt           DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([userId, nextReviewAt])
}

/// One row per user and course, created on the first change. Its absence means
/// "default values": it is not created on enrolment.
model UserCourseSettings {
  userId              String
  courseId            String
  onlyPriorityLessons Boolean  @default(false)
  boardOrientationId  Int
  trainingAfterLesson Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  boardOrientation BoardOrientation @relation(fields: [boardOrientationId], references: [id])

  @@id([userId, courseId])
}

/// Chapters the user chose to train recurrently.
model UserTrainerChapter {
  userId    String
  chapterId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([userId, chapterId])
}

// ---------------------------------------------------------------------------
// Game databases ("Mis estudios" in the interface)
// ---------------------------------------------------------------------------

/// One table, two owners: user (private databases) or course (databases of the
/// published content). CHECK XOR (userId, courseId) in the migration.
model GameDatabase {
  /// Short because it goes in the URL: `/estudios/aB3xK9pQ`. Prisma generates it
  /// on the client, just like `uuid()`, so the column is still TEXT.
  id          String   @id @default(nanoid(8))
  ownerTypeId Int
  userId      String?
  courseId    String?
  /// The chapter whose collection it is.
  ///
  /// A course's collections are per CHAPTER: each one gathers the games its
  /// lessons use. `courseId` stays alongside this one — not instead of it —
  /// because it is what decides who sees the database (a student sees those of the
  /// courses they have started) and what makes it possible to list all of the
  /// course's games at once without joining by chapter.
  chapterId   String?
  name        String
  description String?
  kindId      Int
  /// The database created on sign-up.
  isDefault   Boolean  @default(false)
  /// Order within the course.
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerType OwnerType    @relation(fields: [ownerTypeId], references: [id])
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapter   Chapter?     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  kind      DatabaseKind @relation(fields: [kindId], references: [id])

  games         Game[]
  gamePositions GamePosition[]
  shares        StudyShare[]

  /// A single collection per chapter: it is what makes "this chapter's collection"
  /// one row and not a list that has to be disambiguated.
  @@unique([chapterId])
  @@index([userId])
  @@index([courseId])
}

/// Sharing of a COLLECTION with a student. The collection belongs to its owner —
/// a teacher — and reaches the student through here: they see the database and
/// its games, and cannot write anything. That last part is not imposed by this
/// table but by ownership, which is what every write looks at (see
/// services/studies/study-rules).
///
/// One row per (collection, student): the same collection is shared with several
/// and the unique index prevents sharing it twice with the same one. Removing
/// the share is deleting the row; there is no history because there is nothing
/// to audit — the material goes on existing in the teacher's database.
model StudyShare {
  id         String   @id @default(uuid())
  databaseId String
  userId     String
  /// Record of the teacher who shared it. Nullable so as not to lose the share if
  /// the record is ever removed: the student still has the collection.
  teacherId  String?
  createdAt  DateTime @default(now())

  database GameDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacher  Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([databaseId, userId])
  @@index([userId])
}

/// Headers in columns (list/sort/filter without parsing); the PGN is still the
/// source of the content.
model Game {
  /// Short for the same reason as the study's: both go in the URL.
  id           String    @id @default(nanoid(8))
  databaseId   String
  /// How this game is told apart WITHIN its study ("Capítulo 1").
  /// Nullable on purpose: a game is identified by its players, and only the ones
  /// created blank need a name so they are not all alike. Those imported from a
  /// PGN stay at NULL and go on being shown by their pairing.
  title        String?
  white        String
  black        String
  whiteElo     Int?
  blackElo     Int?
  /// FIDE title exactly as it comes in the PGN: "GM", "WGM", "IM"…
  whiteTitle   String?
  blackTitle   String?
  /// Federation in the PGN's three-letter code ("MEX", "USA"). It is not
  /// ISO-3166: FIDE uses the Olympic code, which differs in several countries.
  whiteCountry String?
  blackCountry String?
  resultId     Int
  playedAt     DateTime? @db.Date
  event        String?
  site         String?
  round        String?
  eco          String?
  /// Null when the game starts at the initial position.
  initialFen   String?
  pgn          String    @db.Text
  /// The user's free tags.
  tags         Json?
  sourceId     Int
  /// Only meaningful in user databases.
  isOwnGame    Boolean   @default(false)
  /// Position within the study, sortable by hand. It rules over the date: once
  /// someone arranges their games, the order is theirs. New ones are created at
  /// the end (max+1), not at 0, so they do not jump to the front.
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  database GameDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  result   GameResult   @relation(fields: [resultId], references: [id])
  source   GameSource   @relation(fields: [sourceId], references: [id])

  classBlocks ClassBlock[]
  positions   GamePosition[]
  /// Lessons that take their content from this game.
  lessons     Lesson[]

  @@index([databaseId, order])
}

/// Position index: one row per position the game went through. It is what makes
/// it possible to search "which games got here" by POSITION and not by sequence
/// of moves, so that transpositions count as a match. It is generated on import
/// (see services/game-positions) and regenerated whole if the PGN changes; it is
/// never edited by hand.
///
/// Without a `fen` column on purpose: it is ~80 rows per game and nobody reads
/// the full FEN — whoever searches already brings their own and any ply's can be
/// recovered by replaying the PGN — so it would only bloat the table.
model GamePosition {
  id           String  @id @default(uuid())
  gameId       String
  /// Denormalised from Game: it allows filtering by owner and origin without
  /// joining Game in the explorer's hot query.
  databaseId   String
  /// Half-moves from the start; 0 is the starting position.
  ply          Int
  /// SHA-256 of the normalised FEN (see lib/chess/position-hash).
  positionHash String
  /// Move made FROM this position; null in the last one. The statistics of
  /// continuations come from here.
  nextMoveSan  String?
  nextMoveUci  String?

  game     Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  database GameDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  /// A position repeated in the same game gives several rows, one per ply:
  /// counting games requires counting distinct gameIds, never rows.
  @@unique([gameId, ply])
  @@index([positionHash])
  @@index([positionHash, databaseId])
  @@index([positionHash, nextMoveUci])
}

// ---------------------------------------------------------------------------
// Classes and teachers
// ---------------------------------------------------------------------------

/// Role over User: the teacher panel opens if this row exists.
/// A teacher is never deleted (it would break classes and historical
/// assignments): they are deactivated with isActive, and then they stop being
/// able to enter /teacher and to take new assignments.
model Teacher {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String
  title       String?
  bio         String?
  photo       String?
  timezone    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  classes  Class[]
  students TeacherStudent[]
  /// Collection shares they made.
  shares   StudyShare[]
}

/// Teacher↔student assignment, independent of the classes: without it a student
/// who does not have classes yet would be invisible to their teacher. endedAt =
/// null ⇒ active. Reassigning CLOSES the row and creates another: the history is
/// never deleted. The "one active teacher per student" rule is imposed by the
/// partial unique index teacher_student_one_active (manual SQL in the
/// migration); to allow several teachers in the future it is enough to remove
/// that index, without touching the model. No status catalog: active/ended is
/// derived from endedAt.
model TeacherStudent {
  id         String    @id @default(uuid())
  teacherId  String
  studentId  String
  assignedAt DateTime  @default(now())
  endedAt    DateTime?
  /// Staff User who made the assignment (lightweight auditing).
  assignedBy String?
  note       String?

  teacher  Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student  User    @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  assigner User?   @relation("AssignmentsMade", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@index([teacherId, endedAt])
  @@index([studentId])
}

/// Administrator/Editor role of the PLATFORM (the row exists = they have the
/// role), the same pattern as Teacher. NOT to be confused with Payload's
/// admin/editor roles, which belong to the public site's CMS and live in another
/// database: they are neither mixed nor reused. If admin and editor are ever
/// separated, a roleId + StaffRole catalog is added here, without touching User.
model Staff {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Class {
  id                    String    @id @default(uuid())
  teacherId             String
  title                 String
  description           String?
  /// Date and time of the class (UTC).
  scheduledAt           DateTime
  durationMin           Int
  statusId              Int
  meetingProviderId     Int?
  meetingUrl            String?
  /// The link is only returned to the client when now >= meetingUrlVisibleFrom.
  meetingUrlVisibleFrom DateTime?
  recordingUrl          String?
  summary               String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  teacher         Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  status          ClassStatus      @relation(fields: [statusId], references: [id])
  meetingProvider MeetingProvider? @relation(fields: [meetingProviderId], references: [id])

  participants ClassParticipant[]
  blocks       ClassBlock[]
  transcript   ClassTranscript?

  @@index([scheduledAt])
  @@index([teacherId, scheduledAt])
}

model ClassParticipant {
  classId    String
  userId     String
  paidAt     DateTime?
  amount     Decimal?  @db.Decimal(10, 2)
  currency   String?
  paymentRef String?
  attended   Boolean   @default(false)
  joinedAt   DateTime?
  createdAt  DateTime  @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
  /// "This student's classes" from the teacher and staff panels: the composite key
  /// starts with classId and does not serve that access.
  @@index([userId])
}

/// Ordered content of the class. A block uses the field of its kind and the
/// references are pointers, never copies. CHECK "at most one reference" in the
/// migration. `movePath` uses the same dotted path as TrainingExercise.path.
model ClassBlock {
  id         String  @id @default(uuid())
  classId    String
  order      Int
  kindId     Int
  text       String? @db.Text
  videoUrl   String?
  gameId     String?
  lessonId   String?
  positionId String?
  movePath   String?
  caption    String?
  /// Game transcribed by the teacher for this class. It lives here and not as a
  /// `Game` because a teacher may have no study at all, and creating one behind
  /// their back just for this would add an entity they did not ask for.
  ///
  /// When there is a PGN here, it RULES over `gameId`: it is this block's game.
  pgn        String? @db.Text

  class    Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  kind     ClassBlockKind @relation(fields: [kindId], references: [id])
  game     Game?          @relation(fields: [gameId], references: [id], onDelete: SetNull)
  lesson   Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  position Position?      @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@unique([classId, order])
}

model ClassTranscript {
  classId    String   @id
  provider   String?
  language   String?
  statusId   Int
  text       String?  @db.Text
  /// [{ startMs, speaker, text }]
  segments   Json?
  durationMs Int?
  createdAt  DateTime @default(now())

  class  Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  status TranscriptStatus @relation(fields: [statusId], references: [id])
}

/// Saved and reusable diagram. CHECK XOR (userId, courseId) in the migration;
/// TEACHER owners use userId (Teacher is 1:1 with User).
model Position {
  id            String   @id @default(uuid())
  ownerTypeId   Int
  userId        String?
  courseId      String?
  title         String?
  fen           String
  orientationId Int
  /// json of arrows [{ orig, dest, color }]
  arrows        Json?
  /// json of highlighted squares [{ square, color }]
  highlights    Json?
  createdAt     DateTime @default(now())

  ownerType   OwnerType        @relation(fields: [ownerTypeId], references: [id])
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orientation BoardOrientation @relation(fields: [orientationId], references: [id])

  classBlocks ClassBlock[]

  @@index([userId])
  @@index([courseId])
}

// ---------------------------------------------------------------------------
// Activity and statistics
// ---------------------------------------------------------------------------

/// Append-only record of every fact about the student: source of truth of all
/// the statistics. It is never updated nor deleted.
model UserActivity {
  id            String   @id @default(uuid())
  userId        String
  typeId        Int
  subjectTypeId Int
  /// uuid of the subject; polymorphic on purpose, without an FK.
  subjectId     String
  topicId       Int?
  occurredAt    DateTime @default(now())
  meta          Json?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ActivityType @relation(fields: [typeId], references: [id])
  subjectType SubjectType  @relation(fields: [subjectTypeId], references: [id])
  topic       Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
}

/// Aggregate derived per user/day/metric/topic; rebuildable in full from
/// UserActivity. topicId NULL = total. In v1 the dashboard computes directly
/// from UserActivity; this table is ready for the rollup. The unique index is
/// replaced in the migration by NULLS NOT DISTINCT.
model UserStatDaily {
  id       String   @id @default(uuid())
  userId   String
  day      DateTime @db.Date
  metricId Int
  topicId  Int?
  value    Int      @default(0)

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric StatMetric @relation(fields: [metricId], references: [id])
  topic  Topic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([userId, day, metricId, topicId])
}
