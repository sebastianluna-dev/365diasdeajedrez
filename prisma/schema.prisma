// Learning platform — domain of the authenticated app.
// Database SEPARATE from Payload's (Payload uses DATABASE_URI; this uses
// PLATFORM_DATABASE_URL). No table of this schema lives with the CMS's.
//
// Decisions fixed by the v2 conceptual diagram:
// - The PGN is the source of the chess content (Lesson.pgn, Game.pgn).
//   There are no per-move tables nor relational move trees.
// - No Prisma/Postgres enums: every restricted domain is a catalog table
//   (unique and stable code; the business logic compares codes, never ids).
//   The values are loaded by an idempotent seed.
// - Composite keys for the progress/join tables.
//
// Constraints Prisma cannot express (added by hand in the initial migration as
// CHECK constraints — see prisma/migrations):
// - GameDatabase: exactly one of (userId, courseId) with a value.
// - Position: exactly one of (userId, courseId) with a value
//   (TEACHER owners point through userId; Teacher is 1:1 with User).
// - ClassBlock: at most one reference (gameId, lessonId, positionId).
// - UserStatDaily: unique index with NULLS NOT DISTINCT so a NULL topicId does
//   not duplicate rows.
// - TeacherStudent: partial unique index teacher_student_one_active over
//   studentId WHERE endedAt IS NULL (one active teacher per student).
// - SourceEntity (unused, see the model): unique index source_entity_name_ci
//   over lower(name).
// - Classes (migration 20261014…_class_payments_and_roles): a payment's amount
//   is positive and buys 1–50 classes; a class lasts more than nothing, a group
//   seats 2–12 and its end is its start plus its duration; a free seat has no
//   payment, and a seat is moved only after a no-show.
// - Exercises (migration 20261016120000_exercises): exercise_difficulty_range
//   (400–3000), exercise_mate_in_range (null or 1–5), exercise_hints_max (at
//   most three hints), exercise_source_year (null or 1400–2100),
//   exercise_series_library_published (a teacher's series is never published
//   to the library) and training_attempt_one_exercise (an attempt is at
//   exactly one of a TrainingExercise or an Exercise).
// - Lesson exercises (migration 20261016130000_lesson_exercises):
//   exercise_single_owner (not both teacherId and lessonId) and
//   exercise_lesson_order_needs_lesson (lessonOrder only with a lessonId).
// Rules validated in the services layer (impossible in a CHECK without
// crossing tables): ownerType↔populated column coherence, ClassBlock.kind↔field
// used; and for the classes (see services/shared/, each rule names its writer):
// format↔capacity and a group's title (classShapeError, createClassRecord); the
// capacity when adding a seat and a student once per class (syncClassSeat,
// after locking the class); a free seat never paid nor a paid one freed
// (syncClassSeat covers only «Sin pago»); a payment's classCount never below
// the seats that count (updatePayment); a reason whenever the staff writes an
// attendance mark, and one CLASS_ATTENDED activity per student and class
// (recordAttendance, after locking the class); and one lock order, every Class
// row of the transaction first, by id (lockClasses), then the student's
// payments by (paidOn, id).

generator client {
  provider        = "prisma-client"
  output          = "../lib/platform-db/generated"
  // `relationLoadStrategy: "join"`: one SQL query per read instead of one per
  // included relation, which matters against a remote database (see docs/
  // architecture/data-access).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Catalogs (they replace enums; upserted by code in the seed)
// ---------------------------------------------------------------------------

/// What a course teaches. A course has SEVERAL (`CourseContentType`) and never
/// none: the minimum of one is the staff action's rule, the database cannot
/// hold it. `label` is the long name ("Estrategia y juego posicional") for the
/// course page; `shortLabel` ("Estrategia") is for tags and table cells.
model ContentType {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  label       String
  shortLabel  String
  description String
  order       Int     @default(0)
  isActive    Boolean @default(true)

  courseContentTypes CourseContentType[]
}

model CourseStatus {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  courses Course[]
}

model AuthorRole {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  courseAuthors CourseAuthor[]
}

/// Kind of resource a course's material comes from: a book, a digital course,
/// a video series… (constants/platform/source-codes.const.ts).
model SourceType {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  courseSources CourseSource[]
}

/// UNUSED since 2026-09-27, like `SourceEntity`: what a source entity was.
/// Nothing reads, writes nor seeds it.
model SourceEntityKind {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  entityLinks SourceEntityKindLink[]
}

/// Role of a chapter or of a lesson within what contains it: to open or to
/// close. The normal ones have NO row here — their `roleId` is null — which is
/// what makes it possible to require "at most one of each" with a unique index
/// over (parent, role) without the normal ones clashing with each other.
model ContentRole {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  chapters Chapter[]
  lessons  Lesson[]
}

/// Who a course is aimed at: "Principiante", "Avanzado"… with an orientative
/// Elo range. A fixed catalog, like the others: six rows that ship with the
/// platform and are not edited from the interface (there was a page for it,
/// /administracion/niveles, for a day). It goes by `slug` and not by `code`
/// because the slug is what the course list is filtered by. Apart from the
/// content types (what the course teaches) and from the sources (where its
/// material comes from).
///
/// The range is inclusive on both ends and an internal, orientative
/// classification: no access is ever decided by it, and a student's missing
/// rating is never stored as a zero. `eloMax` null = no upper bound. The
/// migration adds the check `level_elo_range` (eloMin >= 0, eloMax >= eloMin),
/// which Prisma cannot express.
///
/// `isActive` false hides a level from the student and from the course
/// editor; the courses that had it keep their row in `CourseLevel`.
model Level {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  name        String
  description String
  /// Position by difficulty, the easiest first.
  order       Int     @default(0)
  eloMin      Int
  eloMax      Int?
  isActive    Boolean @default(true)

  courseLevels CourseLevel[]
}

/// Board orientation. Catalog shared by Lesson, Position and
/// UserCourseSettings because it is the same domain concept; AUTO is only valid
/// in UserCourseSettings (subsets by context in
/// constants/platform/shared-codes.const.ts, validated by the services).
model BoardOrientation {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  lessons            Lesson[]
  trainingLessons    Lesson[]             @relation("LessonTrainingColor")
  positions          Position[]
  userCourseSettings UserCourseSettings[]
  games              Game[]
}

model ExerciseMode {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  exercises TrainingExercise[]
}

/// What an exercise asks for (EXERCISE_KIND). SEQUENCE: play the solution, the
/// platform answers the opponent's moves (D01). MATE_IN: solved exactly like
/// SEQUENCE (only the author's lines are accepted, D02); what differs is the
/// title «Mate en N» and that every line of the solution must end in
/// checkmate within N moves (D03).
model ExerciseKind {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  exercises Exercise[]
}

/// Where an exercise is in its life (EXERCISE_STATUS, D16): DRAFT → READY (its
/// teacher's students may get it) → IN_REVIEW → PUBLISHED (the library), and
/// ARCHIVED (kept for history, offered nowhere).
model ExerciseStatus {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  exercises Exercise[]
}

/// Shared by CourseProgress, ChapterProgress and LessonProgress.
model ProgressStatus {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  courseProgresses  CourseProgress[]
  chapterProgresses ChapterProgress[]
  lessonProgresses  LessonProgress[]
}

model AttemptResult {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  attempts       TrainingAttempt[]
  exerciseStates UserExerciseState[]
}

model AttemptContext {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  attempts TrainingAttempt[]
}

/// Polymorphic owner. Shared by GameDatabase (USER/COURSE) and Position
/// (USER/COURSE/TEACHER); validity per table is applied by the services — the
/// real integrity lives in the migration's XOR CHECKs.
model OwnerType {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  gameDatabases GameDatabase[]
  positions     Position[]
}

model DatabaseKind {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  gameDatabases GameDatabase[]
}

/// How a game of a study is gone through by whoever reads it without being
/// able to edit it: with the next moves hidden, for one. The plain analysis is
/// not a row: it is the absence of a mode (`Game.analysisModeId` null).
model GameAnalysisMode {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  games Game[]
}

model GameSource {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  games Game[]
}

/// Game result as a catalog (the spec forbids free strings in restricted
/// domains). `label` carries the PGN token: "1-0", "0-1", "1/2-1/2", "*".
model GameResult {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  games       Game[]
  playedGames PlayedGame[]
}

model ClassStatus {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  classes Class[]
}

model MeetingProvider {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  label    String
  order    Int     @default(0)
  isActive Boolean @default(true)

  classes Class[]
}

model ClassBlockKind {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  blocks ClassBlock[]
}

model TranscriptStatus {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  transcripts ClassTranscript[]
}

/// Individual or group (constants/platform/class-codes.const.ts, CLASS_FORMAT).
model ClassFormat {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  classes Class[]
}

/// When a block of a class reaches its students: to prepare (BEFORE), after
/// the class (AFTER) or never, the teacher's script (TEACHER).
model ClassBlockVisibility {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  blocks ClassBlock[]
}

/// The currencies a payment can be registered in (CURRENCY in
/// constants/platform/currency-codes.const.ts).
model Currency {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  label    String
  order    Int     @default(0)
  isActive Boolean @default(true)

  payments ClassPayment[]
}

model ActivityType {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  activities UserActivity[]
}

model SubjectType {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  activities UserActivity[]
}

model StatMetric {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  dailyStats UserStatDaily[]
}

/// Topic catalog with hierarchy (sub-topics via parentId). Adding a new topic is
/// a row, not a migration.
model Topic {
  id       Int    @id @default(autoincrement())
  code     String @unique
  label    String
  parentId Int?
  order    Int    @default(0)

  parent   Topic?  @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Topic[] @relation("TopicHierarchy")

  lessonTopics   LessonTopic[]
  exerciseTopics ExerciseTopic[]
  activities     UserActivity[]
  dailyStats     UserStatDaily[]
}

// ---------------------------------------------------------------------------
// Content: Course → Chapter → Lesson (the lesson IS a PGN)
// ---------------------------------------------------------------------------

model Course {
  /// 8-digit numeric: it goes in the student's URL (`/cursos/00020212`).
  /// The application sets it (lib/numeric-id.ts), not Prisma.
  id             String    @id
  name           String
  slug           String    @unique
  description    String?
  /// Reserved: "conocimientos previos" was taken out of the course editor the
  /// day it shipped. Nothing reads nor writes it; the column stays so that
  /// removing the field did not take a destructive migration.
  priorKnowledge String?
  /// The wide image of the course, 21:9: its information page and the catalog.
  cover          String?
  /// The square one, 1:1: the row of «Mis cursos». Without it that row falls
  /// back to the cover, cropped square by Cloudinary.
  thumbnail      String?
  statusId       Int
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  status CourseStatus @relation(fields: [statusId], references: [id])

  chapters           Chapter[]
  courseAuthors      CourseAuthor[]
  courseLevels       CourseLevel[]
  courseContentTypes CourseContentType[]
  sources            CourseSource[]
  progresses         CourseProgress[]
  settings           UserCourseSettings[]
  gameDatabases      GameDatabase[]
  positions          Position[]
}

model Author {
  id    String  @id @default(uuid())
  name  String
  slug  String  @unique
  bio   String?
  photo String?

  courseAuthors CourseAuthor[]
}

model CourseAuthor {
  courseId String
  authorId String
  roleId   Int
  order    Int    @default(0)

  course Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author Author     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  role   AuthorRole @relation(fields: [roleId], references: [id])

  @@id([courseId, authorId])
}

model CourseLevel {
  courseId String
  levelId  Int

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  level  Level  @relation(fields: [levelId], references: [id])

  @@id([courseId, levelId])
}

model CourseContentType {
  courseId      String
  contentTypeId Int

  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  contentType ContentType @relation(fields: [contentTypeId], references: [id])

  @@id([courseId, contentTypeId])
}

/// UNUSED since 2026-09-27. It was the platform, publisher or provider a
/// course's source cited, edited at /administracion/entidades; the page, the
/// field of the source form and everything that read them were taken out.
/// The three tables (`SourceEntity`, `SourceEntityKind`,
/// `SourceEntityKindLink`) and `CourseSource.entityId` stay in the database,
/// empty, so that removing the feature did not take a destructive migration;
/// dropping them is one, whenever it is wanted.
model SourceEntity {
  id          String   @id @default(uuid())
  name        String
  website     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  kinds   SourceEntityKindLink[]
  sources CourseSource[]
}

model SourceEntityKindLink {
  entityId String
  kindId   Int

  entity SourceEntity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  kind   SourceEntityKind @relation(fields: [kindId], references: [id])

  @@id([entityId, kindId])
}

/// Where a course's material comes from ("Procedencia del recurso"). Several
/// per course, one resource each; only the type is required, so material of
/// the academy's own making needs no title nor URL. A compilation is simply
/// several rows.
model CourseSource {
  id           String @id @default(uuid())
  courseId     String
  sourceTypeId Int
  /// Insertion order; gaps after a deletion are fine, the list only has to be stable.
  order        Int

  originalTitle     String?
  /// Authors of the RESOURCE as free text, several separated by commas. Not
  /// the platform's `Author`: who wrote the book is not who signs the course.
  authors           String?
  /// Unused, see `SourceEntity`.
  entityId          String?
  url               String?
  publicationYear   Int?
  edition           String?
  /// Chapters, pages or lessons of the resource the course draws on.
  specificReference String?
  /// Staff only: the student never sees it.
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  course     Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sourceType SourceType    @relation(fields: [sourceTypeId], references: [id])
  entity     SourceEntity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  @@index([courseId, order])
  @@index([entityId])
}

model Chapter {
  id                String  @id @default(uuid())
  courseId          String
  name              String
  description       String?
  order             Int
  /// The staff marked the whole chapter as priority: its card says so, and
  /// every lesson of it passes the student's «Prioridad» filter.
  isPriority        Boolean @default(false)
  /// Introduction or closing of the course; null in normal chapters, which are
  /// the majority. At most one of each per course (partial unique index).
  roleId            Int?
  /// Estimated minutes: the CACHED SUM of its lessons' `estimatedDuration`, so
  /// that showing a chapter's duration never reads its lessons. Nobody types it:
  /// its only writer is `syncChapterDuration`
  /// (services/shared/chapter-duration.service.ts), called inside the same
  /// transaction as every write that creates, changes or deletes a lesson. Null
  /// when no lesson of the chapter declares minutes — never 0, which would read
  /// as "it takes no time".
  estimatedDuration Int?

  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  role   ContentRole? @relation(fields: [roleId], references: [id])

  lessons         Lesson[]
  progresses      ChapterProgress[]
  trainerChapters UserTrainerChapter[]
  /// Its game collection; at most one (see GameDatabase's index).
  gameDatabases   GameDatabase[]

  @@unique([courseId, order])
  /// At most one introduction and one closing per course. The normal ones have a
  /// null `roleId` and NULL does not clash with NULL, so they stay out of the index.
  @@unique([courseId, roleId])
}

model Lesson {
  /// 8-digit numeric: it goes in the student's URL (`/lecciones/02482009`).
  id                String    @id
  chapterId         String
  name              String
  description       String?
  order             Int
  /// Essential lesson of the course (editorial mark; the filter is the student's).
  isPriority        Boolean   @default(false)
  /// Introduction or closing of the chapter; null in normal lessons.
  roleId            Int?
  /// Estimated minutes. It is the only one typed by hand, and what its chapter's
  /// `estimatedDuration` adds up.
  estimatedDuration Int?
  orientationId     Int
  /// Game of the course collection the content comes from.
  ///
  /// When it is set IT RULES: the lesson's content is that game's PGN, so that
  /// fixing it fixes every lesson that uses it. When it is null `pgn` rules, which
  /// is how lessons were born and how the ones that reference nothing still work.
  ///
  /// Which one rules is resolved in ONE single place: `lessonPgnOf`
  /// (services/shared/lesson-pgn.ts). Nobody should read `pgn` on their own.
  gameId            String?
  /// The lesson's own content. Inert while there is a `gameId`; it is kept and not
  /// deleted on linking, so that unlinking returns the lesson to what it had.
  pgn               String    @db.Text
  /// When `pgn` last changed. It is what marks as stale the exercises frozen
  /// before the change.
  pgnUpdatedAt      DateTime?
  /// The lesson can be trained from memory in the Move Trainer. Enabling it
  /// derives a TrainingExercise with ITS MAIN LINE; the variations go on existing
  /// for study mode, but the review does not evaluate them.
  isTrainable       Boolean   @default(false)
  /// Side the STUDENT plays when training, when it is not the one that moves
  /// first. Null = whoever moves first in the line. It serves black repertoires:
  /// in "1.e4 c6 2.d4 d5" the student must answer c6 and d5, not play e4.
  /// It is different from `orientation`, which only decides how the board is seen.
  trainingColorId   Int?

  chapter       Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  role          ContentRole?      @relation(fields: [roleId], references: [id])
  /// SetNull and not Cascade: if someone deletes the game from the collection, the
  /// lesson goes on existing — with its name, its topics and its progress — and is
  /// left without content until another one is linked to it.
  game          Game?             @relation(fields: [gameId], references: [id], onDelete: SetNull)
  orientation   BoardOrientation  @relation(fields: [orientationId], references: [id])
  trainingColor BoardOrientation? @relation("LessonTrainingColor", fields: [trainingColorId], references: [id])

  /// The line trainer's derived drill (isDerived). Renamed from `exercises`
  /// on 2026-10-16 so no reader counts the new lesson exercises by mistake.
  trainingExercises TrainingExercise[]
  /// The lesson's own exercises (D04, D05): Exercise rows with this lesson
  /// as owner, in lessonOrder; the archived ones have none.
  lessonExercises   Exercise[]
  trainings         UserLessonTraining[]
  progresses        LessonProgress[]
  lessonTopics      LessonTopic[]
  classBlocks       ClassBlock[]
  courseProgresses  CourseProgress[]     @relation("CourseProgressLastLesson")

  @@unique([chapterId, order])
  /// At most one introduction and one closing per chapter; see Chapter.
  @@unique([chapterId, roleId])
  @@index([gameId])
}

/// Declares a trainable segment of the PGN. `path` uses dotted paths of child
/// indexes from the root ("0.0.1.0"); startFen + line are frozen so the trainer
/// does not depend on parsing nor break if the author edits the PGN.
model TrainingExercise {
  id         String    @id @default(uuid())
  lessonId   String
  order      Int
  modeId     Int
  path       String
  startPly   Int
  endPly     Int
  startFen   String
  /// SAN of the segment, space-separated, frozen on publishing.
  line       String
  /// Moment startFen and line were frozen. The exercise becomes "stale" when
  /// Lesson.pgnUpdatedAt is later: it is still trainable (the frozen copy is
  /// self-sufficient) but it may no longer reflect the lesson.
  frozenAt   DateTime?
  promptText String?
  /// The system generated it from the lesson's main line, not the staff. It is
  /// regenerated when the PGN is edited and disappears if the lesson stops being
  /// trainable; hand-made exercises are never touched.
  isDerived  Boolean   @default(false)

  lesson Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  mode   ExerciseMode @relation(fields: [modeId], references: [id])

  attempts TrainingAttempt[]

  @@unique([lessonId, order])
}

model LessonTopic {
  lessonId String
  topicId  Int

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([lessonId, topicId])
}

// ---------------------------------------------------------------------------
// User, progress and study settings
// ---------------------------------------------------------------------------

/// The student's identity. It is also the credential: the platform delegates
/// authentication neither to Payload (which only manages the public site's CMS)
/// nor to an external provider, so the password hash lives here.
model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String
  createdAt   DateTime @default(now())

  /// scrypt hash with its parameters embedded (see lib/platform-auth/password.ts).
  /// null = account created without a credential yet: it cannot log in.
  passwordHash      String?
  passwordUpdatedAt DateTime?
  lastLoginAt       DateTime?

  /// The person's user name: the address of their profile, `/perfil/<slug>`.
  /// Proposed from the name when the account is created (`proposeUserSlug`,
  /// services/shared/user-slug.service.ts, called by whoever creates it) and
  /// changed only by the person in «Ajustes» (`setUserSlug`). CHECK
  /// `user_slug_format` in the migration: 3–30 lower-case letters, digits and
  /// single dashes. Addressed by slug and not by code, as Level is: it goes in
  /// the URL. Its P2002 is `User_slug_key`.
  slug       String  @unique
  /// One line the person writes about themselves, on their profile. Optional.
  statusLine String? @db.VarChar(120)
  /// FIDE's three-letter federation code (lib/chess/federations.ts), as
  /// Game.whiteCountry: the flag beside their name. Optional.
  country    String?

  /// Minutes of study the student sets themselves per day. A column and not a
  /// settings table because today it is the only setting that does not hang from a
  /// course (the ones that do live in UserCourseSettings); if more appear, they
  /// move together.
  dailyGoalMinutes Int @default(30)

  sessions          Session[]
  teacher           Teacher?
  staff             Staff?
  courseProgresses  CourseProgress[]
  chapterProgresses ChapterProgress[]
  lessonProgresses  LessonProgress[]
  attempts          TrainingAttempt[]
  lessonTrainings   UserLessonTraining[]
  courseSettings    UserCourseSettings[]
  trainerChapters   UserTrainerChapter[]
  gameDatabases     GameDatabase[]
  /// Collections that have been shared with them.
  studyShares       StudyShare[]
  studyVisits       StudyVisit[]
  positions         Position[]
  classParticipants ClassParticipant[]   @relation("ClassParticipantUser")
  activities        UserActivity[]
  dailyStats        UserStatDaily[]

  /// Classes: what this user paid for, and what they did as staff or teacher.
  paymentsAsStudent  ClassPayment[]          @relation("ClassPaymentStudent")
  paymentsRecorded   ClassPayment[]          @relation("ClassPaymentRecorder")
  classesCreated     Class[]                 @relation("ClassCreatedBy")
  classesRescheduled Class[]                 @relation("ClassRescheduledBy")
  classesCancelled   Class[]                 @relation("ClassCancelledBy")
  classesClosed      Class[]                 @relation("ClassClosedBy")
  participantsAdded  ClassParticipant[]      @relation("ClassParticipantAddedBy")
  seatsMoved         ClassParticipant[]      @relation("ClassSeatMovedBy")
  attendanceChanges  ClassAttendanceChange[] @relation("ClassAttendanceChangedBy")

  /// Exercises: what this user wrote or reviewed, the series they built, the
  /// series given to them and their standing with each exercise they tried.
  exercisesAuthored    Exercise[]            @relation("ExerciseAuthor")
  exercisesReviewed    Exercise[]            @relation("ExerciseReviewer")
  seriesCreated        ExerciseSeries[]      @relation("ExerciseSeriesCreator")
  exerciseSeriesShares ExerciseSeriesShare[]
  exerciseStates       UserExerciseState[]

  /// Games played on the platform, in each seat (never study games).
  playedGamesAsWhite PlayedGame[] @relation("PlayedGameWhiteUser")
  playedGamesAsBlack PlayedGame[] @relation("PlayedGameBlackUser")

  /// Assignments in which this user is the student.
  studentAssignments TeacherStudent[] @relation("StudentAssignments")
  /// Assignments this user (staff) made: lightweight auditing.
  assignmentsMade    TeacherStudent[] @relation("AssignmentsMade")
}

/// Open session. The token travelling in the cookie is an opaque random value of
/// which only its SHA-256 is stored: if someone reads this table they cannot
/// impersonate anyone. The real expiry is `expiresAt` (the cookie only
/// transports the token), so logging out or revoking takes effect immediately
/// without depending on the browser.
model Session {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  /// Last time it was used; it serves the sliding renewal and telling live
  /// sessions from abandoned ones.
  lastSeenAt DateTime @default(now())
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Rate-limit windows for the server actions.
///
/// It lives in the database and not in the process's memory because the ceiling
/// has to be ONE for the whole app: with the counter in memory, two instances
/// behind a load balancer give twice the attempts — and in serverless every cold
/// start begins at zero, which is exactly what a brute-force attack needs.
///
/// `key` identifies the subject and the operation (`login:ana@ejemplo.com`,
/// `<userId>:import`). The rows expire on their own: they are deleted when they
/// run out, with no need for a separate process to collect them.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model CourseProgress {
  userId       String
  courseId     String
  statusId     Int
  startedAt    DateTime?
  completedAt  DateTime?
  /// Return point of "continue studying".
  lastLessonId String?

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status     ProgressStatus @relation(fields: [statusId], references: [id])
  lastLesson Lesson?        @relation("CourseProgressLastLesson", fields: [lastLessonId], references: [id], onDelete: SetNull)

  @@id([userId, courseId])
}

model ChapterProgress {
  userId       String
  chapterId    String
  statusId     Int
  startedAt    DateTime?
  completedAt  DateTime?
  quizPassedAt DateTime?

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  status  ProgressStatus @relation(fields: [statusId], references: [id])

  @@id([userId, chapterId])
}

model LessonProgress {
  userId      String
  lessonId    String
  statusId    Int
  startedAt   DateTime?
  completedAt DateTime?

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status ProgressStatus @relation(fields: [statusId], references: [id])

  @@id([userId, lessonId])
}

/// Append-only history; it is never updated. One table for the attempts at
/// both kinds of exercise: the dormant line trainer's (trainingExerciseId) and
/// an Exercise's (exerciseId).
model TrainingAttempt {
  id                 String   @id @default(uuid())
  userId             String
  /// The derived line exercise (the dormant trainer). Exactly one of
  /// trainingExerciseId / exerciseId is set: CHECK training_attempt_one_exercise.
  trainingExerciseId String?
  /// An Exercise. Only writer of these rows: recordExerciseAttempt
  /// (services/shared/exercise-attempt.service.ts).
  exerciseId         String?
  /// Where it was solved: the series (D24 per series); later the
  /// contrarreloj run.
  seriesId           String?
  /// The class block it was solved from (D29, context CLASS). Only writer:
  /// recordExerciseAttempt (services/shared/exercise-attempt.service.ts).
  /// SetNull: a block deleted leaves its attempts, with no block.
  classBlockId       String?
  resultId           Int
  mistakes           Int      @default(0)
  durationMs         Int?
  contextId          Int
  /// Moves of the student the line asked for.
  requiredMoves      Int      @default(0)
  /// Got right first time. `mistakes` counts the failures, which can repeat on the
  /// same move, so correctMoves is NOT requiredMoves - mistakes.
  correctMoves       Int      @default(0)
  /// How far in plies they got. It is the DENOMINATOR for knowing how many times a
  /// position was passed through: without this, the stored mistakes cannot be
  /// turned into a percentage of successes.
  reachedPly         Int      @default(0)
  hintsUsed          Int      @default(0)
  /// «Ver la solución» was pressed (D20): the attempt is FAILED whatever the
  /// moves were.
  solutionShown      Boolean  @default(false)
  /// The whole sequence first time and without hints. It is stored apart from the
  /// accuracy: one can get 92 % right and not have a perfect review.
  isPerfect          Boolean  @default(false)
  /// Set only by the migration 20261016130000_lesson_exercises, on the
  /// attempts it moved from the hand-made TrainingExercise rows into
  /// Exercise: they were recorded under the trainer's rules (PASSED allowed
  /// mistakes, no study-day rule), so rebuildUserExerciseState folds them as
  /// the migration did (counts, dates, firstSolvedAt; no review, no day
  /// gate). No code writes it.
  isLegacy           Boolean  @default(false)
  createdAt          DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingExercise TrainingExercise? @relation(fields: [trainingExerciseId], references: [id], onDelete: Cascade)
  /// Restrict: an exercise someone tried is archived, never deleted (its
  /// history and the teacher's view of the mistakes depend on it).
  exercise         Exercise?         @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  series           ExerciseSeries?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  classBlock       ClassBlock?       @relation(fields: [classBlockId], references: [id], onDelete: SetNull)
  result           AttemptResult     @relation(fields: [resultId], references: [id])
  context          AttemptContext    @relation(fields: [contextId], references: [id])

  mistakeDetails TrainingMistake[]

  @@index([userId, createdAt])
  @@index([trainingExerciseId])
  @@index([exerciseId, userId])
  @@index([seriesId, userId])
  @@index([classBlockId, userId])
}

/// One row PER FAILED MOVE, not per move. A student who gets everything right
/// writes none, so the table grows with the mistakes and not with the usage.
///
/// The position is identified by the hash of its FEN (lib/chess/position-hash.ts)
/// and not by the move number: that way the data survives the PGN being edited,
/// and it groups the same position reached by transposition from another lesson.
///
/// Only writer: recordExerciseAttempt (services/shared/exercise-attempt.service.ts).
/// For an Exercise attempt there is at most one row, the first wrong move: it
/// decides the attempt (D19), and what the student plays afterwards to learn
/// is not stored.
model TrainingMistake {
  id           String   @id @default(uuid())
  attemptId    String
  positionHash String
  fen          String
  expectedSan  String
  playedSan    String
  /// Ply within the line, so it can be crossed with `reachedPly`.
  ply          Int
  usedHint     Boolean  @default(false)
  createdAt    DateTime @default(now())

  attempt TrainingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([positionHash])
}

/// Current state of the student with a trainable lesson, kept apart from the
/// attempt history so that what is due for review can be known at a glance.
///
/// It hangs from (userId, lessonId) and NOT from the dotted path within the PGN:
/// those paths are reordered when a variation is promoted, so tying the progress
/// to them would lose it on the first edit. The lesson is the stable identity.
model UserLessonTraining {
  userId              String
  lessonId            String
  totalAttempts       Int       @default(0)
  perfectAttempts     Int       @default(0)
  /// Percentage 0-100 of the last attempt and of the best one.
  lastAccuracy        Int       @default(0)
  bestAccuracy        Int       @default(0)
  /// Consecutive perfect reviews: it is what climbs the ladder's rung.
  consecutivePerfect  Int       @default(0)
  currentIntervalDays Int       @default(0)
  /// Current rung, so as not to recompute it from the interval.
  masteryLevel        Int       @default(0)
  lastReviewedAt      DateTime?
  nextReviewAt        DateTime?
  updatedAt           DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([userId, nextReviewAt])
}

/// One row per user and course, created on the first change. Its absence means
/// "default values": it is not created on enrolment.
model UserCourseSettings {
  userId              String
  courseId            String
  onlyPriorityLessons Boolean  @default(false)
  boardOrientationId  Int
  trainingAfterLesson Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  boardOrientation BoardOrientation @relation(fields: [boardOrientationId], references: [id])

  @@id([userId, courseId])
}

/// Chapters the user chose to train recurrently.
model UserTrainerChapter {
  userId    String
  chapterId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([userId, chapterId])
}

// ---------------------------------------------------------------------------
// Exercises: the bank, its series and the student's standing with each one
// ---------------------------------------------------------------------------
//
// One table, Exercise, holds every authored exercise: a teacher's and the
// academy's library (and, from the lesson exercises' migration, a lesson's).
// An exercise is a starting position and a solution played on the board, with
// variants and comments, kept as a PGN (solutionPgn): the student plays their
// moves and the platform answers until the line ends (D01, D02). The attempts
// reuse TrainingAttempt and TrainingMistake. See docs/ → Platform → Data model.

model Exercise {
  /// Short, it goes in the URL. Prisma generates it (nanoid(8), like
  /// GameDatabase).
  id                String    @id @default(nanoid(8))
  /// Owner (D07). Set: the teacher's. Null: the academy's — what the staff
  /// writes and what the library holds. Restrict: a teacher is never deleted
  /// (see Teacher).
  teacherId         String?
  /// Who wrote it, for «Creado por» and the audit. Not the owner.
  authorUserId      String?
  /// An input of the solution's validity (MATE_IN lines must mate within
  /// mateIn), so it has the solution's writers: createExerciseRecord /
  /// syncExerciseSolution, through exerciseSolutionColumns.
  kindId            Int
  /// Only writer: services/shared/exercise-status.service.ts. An insert starts
  /// DRAFT through a spread of initialExerciseStatusData() (exported by that
  /// file); any other status is reached with transitionOwnExercise or
  /// reviewLibraryExercise in the same transaction.
  statusId          Int
  title             String    @db.VarChar(120)
  /// «Juegan blancas y ganan». Null: the screen says «Juegan blancas» or
  /// «Juegan negras» (and «y dan mate en N»).
  prompt            String?   @db.VarChar(200)
  /// The author's Elo-like difficulty (D14, D38). CHECK
  /// exercise_difficulty_range (400–3000). The Level is derived from it on
  /// reading (levelOfDifficulty), never stored.
  difficulty        Int
  /// The author's text hints, in order, at most three (CHECK
  /// exercise_hints_max). Empty: the hint highlights the piece to move (D37).
  hints             String[]  @default([])
  /// Shown after solving (D13).
  explanation       String?   @db.Text
  /// N of «Mate en N»; null for SEQUENCE (CHECK exercise_mate_in_range, 1–5).
  /// The kind↔mateIn rule (MATE_IN needs it, SEQUENCE has none) is enforced by
  /// exerciseSolutionColumns; same writers as kindId: createExerciseRecord /
  /// syncExerciseSolution.
  mateIn            Int?
  /// THE SOURCE (D02, D10): [SetUp]/[FEN] + the solution with variants and
  /// comments, no other header. Written only by createExerciseRecord /
  /// syncExerciseSolution (services/shared/exercise-record.service.ts), always
  /// together with kindId, mateIn and the four frozen columns below.
  solutionPgn       String    @db.Text
  /// Frozen from solutionPgn by exerciseSolutionColumns (writers:
  /// createExerciseRecord / syncExerciseSolution): lists draw it without
  /// parsing. A draft has them too, so they are NOT NULL for every status.
  startFen          String
  /// createPositionHash(startFen), by exerciseSolutionColumns (writers:
  /// createExerciseRecord / syncExerciseSolution): the import's «Ya está en
  /// tus ejercicios».
  startPositionHash String
  /// Plies of the main line, by exerciseSolutionColumns (writers:
  /// createExerciseRecord / syncExerciseSolution).
  solutionPlies     Int
  /// The student's moves in the main line («3 jugadas»), by
  /// exerciseSolutionColumns (writers: createExerciseRecord /
  /// syncExerciseSolution).
  playerMoves       Int
  /// Source (D13). CHECK exercise_source_year (1400–2100).
  sourceWhite       String?   @db.VarChar(120)
  sourceBlack       String?   @db.VarChar(120)
  sourceEvent       String?   @db.VarChar(160)
  sourceYear        Int?
  /// The study game it came from («Crear ejercicio desde aquí», D11). SetNull:
  /// the exercise is self-sufficient.
  sourceGameId      String?
  /// The exercise it was copied from («Duplicar»; a library exercise copied to
  /// a lesson, D28).
  copiedFromId      String?
  /// Owner when set: the lesson's exercise (D04, D05), authored by the staff,
  /// never in a bank, a series or the library. CHECK exercise_single_owner:
  /// not both teacherId and lessonId. Cascade: a lesson deleted takes its
  /// exercises (deleteLesson refuses when one of them has attempts, which
  /// are RESTRICT).
  lessonId          String?
  /// Its place in the lesson; null for an archived one, cleared by
  /// exercise-status.service.ts when it archives it and given back, one past
  /// the highest, when it restores it (CHECK exercise_lesson_order_needs_lesson).
  /// Unique per lesson: the panel reorders through services/shared/reorder.ts,
  /// the next place and the closing of a gap are
  /// services/shared/lesson-exercise-order.service.ts's, and an insert that
  /// finds its order taken answers `orderTaken` (isUniqueConstraintError).
  lessonOrder       Int?
  /// The review (D16). Only writer: services/shared/exercise-status.service.ts
  /// (transitionOwnExercise / reviewLibraryExercise). publishedAt is the FIRST
  /// publication and is kept when the exercise leaves the library: «was ever in
  /// the library» is what lets a teacher keep seeing the attempts at it. Never
  /// copied by «Duplicar» or a lesson copy.
  submittedAt       DateTime?
  /// Only writer: exercise-status.service.ts (reviewLibraryExercise).
  reviewedAt        DateTime?
  /// Only writer: exercise-status.service.ts (reviewLibraryExercise).
  reviewedById      String?
  /// Only writer: exercise-status.service.ts (reviewLibraryExercise).
  reviewNote        String?   @db.VarChar(500)
  /// Only writer: exercise-status.service.ts (reviewLibraryExercise).
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  teacher    Teacher?       @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  authorUser User?          @relation("ExerciseAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  reviewedBy User?          @relation("ExerciseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  kind       ExerciseKind   @relation(fields: [kindId], references: [id])
  status     ExerciseStatus @relation(fields: [statusId], references: [id])
  sourceGame Game?          @relation(fields: [sourceGameId], references: [id], onDelete: SetNull)
  copiedFrom Exercise?      @relation("ExerciseCopies", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies     Exercise[]     @relation("ExerciseCopies")
  lesson     Lesson?        @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  topics          ExerciseTopic[]
  seriesItems     ExerciseSeriesItem[]
  classBlockItems ClassBlockExercise[]
  attempts        TrainingAttempt[]
  states          UserExerciseState[]

  @@unique([lessonId, lessonOrder])
  @@index([teacherId, statusId])
  @@index([statusId, difficulty])
  @@index([startPositionHash])
  @@index([sourceGameId])
}

/// The topics of an exercise (D15: the courses' Topic catalog). Written only
/// with syncCatalogJoin, inside the exercise's write.
model ExerciseTopic {
  exerciseId String
  topicId    Int

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  topic    Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([exerciseId, topicId])
  @@index([topicId])
}

/// An ordered set of exercises built by an author (D18). A teacher's
/// (teacherId) reaches students only through ExerciseSeriesShare (D31); the
/// academy's (teacherId null) is the library's, listed once publishedAt is
/// set (CHECK exercise_series_library_published: teacherId IS NULL OR
/// publishedAt IS NULL).
model ExerciseSeries {
  id          String    @id @default(nanoid(8))
  teacherId   String?
  title       String    @db.VarChar(120)
  description String?   @db.VarChar(1000)
  publishedAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("ExerciseSeriesCreator", fields: [createdById], references: [id], onDelete: SetNull)

  items    ExerciseSeriesItem[]
  shares   ExerciseSeriesShare[]
  attempts TrainingAttempt[]

  @@index([teacherId])
}

/// The order goes through services/shared/reorder.ts: the order is unique per
/// series, so a direct swap throws P2002.
model ExerciseSeriesItem {
  seriesId   String
  exerciseId String
  order      Int

  series   ExerciseSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([seriesId, exerciseId])
  @@unique([seriesId, order])
  @@index([exerciseId])
}

/// A teacher's series given to one student (D31), the twin of StudyShare: one
/// row per (series, student); removing the share deletes the row, and the
/// material stays the teacher's.
model ExerciseSeriesShare {
  id        String   @id @default(uuid())
  seriesId  String
  userId    String
  teacherId String?
  createdAt DateTime @default(now())

  series  ExerciseSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacher Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([seriesId, userId])
  @@index([userId])
}

/// The student's standing with one exercise: whether they ever solved it (D22)
/// and when it comes back (D23). Derived from TrainingAttempt; its only writer
/// is recordExerciseAttempt (and rebuildUserExerciseState, which folds the
/// same rule over the history), both in
/// services/shared/exercise-attempt.service.ts. A row created only to hold
/// the family's lock (lockExerciseFamily) has attemptCount 0 and no dates.
model UserExerciseState {
  userId         String
  exerciseId     String
  /// Only writer: recordExerciseAttempt (and rebuildUserExerciseState).
  attemptCount   Int       @default(0)
  /// Only writer: recordExerciseAttempt (and rebuildUserExerciseState).
  firstAttemptAt DateTime?
  /// The first PASSED attempt: what makes the streak and «Ejercicios
  /// superados» count an exercise once. Only writer: recordExerciseAttempt
  /// (and rebuildUserExerciseState).
  firstSolvedAt  DateTime?
  /// Only writer: recordExerciseAttempt (and rebuildUserExerciseState).
  lastAttemptAt  DateTime?
  /// Only writer: recordExerciseAttempt (and rebuildUserExerciseState).
  lastResultId   Int?
  /// Rung of EXERCISE_REVIEW_INTERVALS_DAYS; null = not in review (never
  /// failed, or graduated). Only writer: recordExerciseAttempt (and
  /// rebuildUserExerciseState), through applyExerciseReview.
  reviewStep     Int?
  /// Only writer: recordExerciseAttempt (and rebuildUserExerciseState),
  /// through applyExerciseReview.
  nextReviewAt   DateTime?
  /// Only writer: recordExerciseAttempt (and rebuildUserExerciseState).
  lastReviewedAt DateTime?
  updatedAt      DateTime  @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  lastResult AttemptResult? @relation(fields: [lastResultId], references: [id])

  @@id([userId, exerciseId])
  @@index([userId, nextReviewAt])
  @@index([userId, firstSolvedAt])
  @@index([exerciseId])
}

// ---------------------------------------------------------------------------
// Game databases ("Mis estudios" in the interface)
// ---------------------------------------------------------------------------

/// One table, two owners: user (private databases) or course (databases of the
/// published content). CHECK XOR (userId, courseId) in the migration.
model GameDatabase {
  /// Short because it goes in the URL: `/estudios/aB3xK9pQ`. Prisma generates it
  /// on the client, just like `uuid()`, so the column is still TEXT.
  id          String   @id @default(nanoid(8))
  ownerTypeId Int
  userId      String?
  courseId    String?
  /// The chapter whose collection it is.
  ///
  /// A course's collections are per CHAPTER: each one gathers the games its
  /// lessons use. `courseId` stays alongside this one — not instead of it —
  /// because it is what decides who sees the database (a student sees those of the
  /// courses they have started) and what makes it possible to list all of the
  /// course's games at once without joining by chapter.
  chapterId   String?
  name        String
  description String?
  kindId      Int
  /// The database created on sign-up.
  isDefault   Boolean  @default(false)
  /// Order within the course.
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerType OwnerType    @relation(fields: [ownerTypeId], references: [id])
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapter   Chapter?     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  kind      DatabaseKind @relation(fields: [kindId], references: [id])

  games         Game[]
  gamePositions GamePosition[]
  shares        StudyShare[]
  visits        StudyVisit[]

  /// A single collection per chapter: it is what makes "this chapter's collection"
  /// one row and not a list that has to be disambiguated.
  @@unique([chapterId])
  @@index([userId])
  @@index([courseId])
}

/// Sharing of a COLLECTION with a student. The collection belongs to its owner —
/// a teacher — and reaches the student through here: they see the database and
/// its games, and cannot write anything. That last part is not imposed by this
/// table but by ownership, which is what every write looks at (see
/// services/studies/study-rules).
///
/// One row per (collection, student): the same collection is shared with several
/// and the unique index prevents sharing it twice with the same one. Removing
/// the share is deleting the row; there is no history because there is nothing
/// to audit — the material goes on existing in the teacher's database.
/// The last game a person opened in a study (2026-10-07): «Mis estudios» opens the
/// study on it, its card shows where that game ends, and the list's «Recientes»
/// orders by `openedAt`. One row per person and study, overwritten each time a
/// game of the study is on screen; its only writer is `rememberOpenedGame`
/// (services/studies/studies.actions.ts), which the game page calls from the
/// browser once the game is shown, so a page Next prefetches writes nothing.
///
/// Per person and not on the study: a collection a teacher shares is one study
/// and many readers, who could not write on it anyway, and writing on the study
/// would move its `updatedAt` for having been looked at. Which move the board
/// was on inside the game is the browser's to keep (localStorage), not this
/// table's: it changes with every move.
model StudyVisit {
  id         String   @id @default(uuid())
  userId     String
  databaseId String
  /// Null once that game is deleted: the study then opens on its first game
  /// again, and keeps its place in «Recientes».
  gameId     String?
  openedAt   DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  database GameDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  game     Game?        @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@unique([userId, databaseId])
  @@index([databaseId])
  @@index([gameId])
}

model StudyShare {
  id         String   @id @default(uuid())
  databaseId String
  userId     String
  /// Record of the teacher who shared it. Nullable so as not to lose the share if
  /// the record is ever removed: the student still has the collection.
  teacherId  String?
  createdAt  DateTime @default(now())

  database GameDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacher  Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([databaseId, userId])
  @@index([userId])
}

/// Headers in columns (list/sort/filter without parsing); the PGN is still the
/// source of the content.
model Game {
  /// Short for the same reason as the study's: both go in the URL.
  id             String    @id @default(nanoid(8))
  databaseId     String
  /// How this game is told apart WITHIN its study ("Capítulo 1").
  /// Nullable on purpose: a game is identified by its players, and only the ones
  /// created blank need a name so they are not all alike. Those imported from a
  /// PGN stay at NULL and go on being shown by their pairing.
  title          String?
  white          String
  black          String
  whiteElo       Int?
  blackElo       Int?
  /// FIDE title exactly as it comes in the PGN: "GM", "WGM", "IM"…
  whiteTitle     String?
  blackTitle     String?
  /// Federation in the PGN's three-letter code ("MEX", "USA"). It is not
  /// ISO-3166: FIDE uses the Olympic code, which differs in several countries.
  whiteCountry   String?
  blackCountry   String?
  resultId       Int
  playedAt       DateTime? @db.Date
  event          String?
  site           String?
  round          String?
  eco            String?
  /// Null when the game starts at the initial position.
  initialFen     String?
  pgn            String    @db.Text
  /// The user's free tags.
  tags           Json?
  sourceId       Int
  /// Only meaningful in user databases.
  isOwnGame      Boolean   @default(false)
  /// Which side the board opens from for this game. Null = White at the bottom.
  /// Its owner sets it from the game's settings in the list.
  orientationId  Int?
  /// How a reader goes through the game. Null = plain analysis.
  analysisModeId Int?
  /// A text of the owner's shown at the head of the notation, before the
  /// moves, for everyone who opens the game. It is not part of the PGN: it is
  /// about the game in this study, not something the game says.
  pinnedComment  String?   @db.Text
  /// Position within the study, sortable by hand. It rules over the date: once
  /// someone arranges their games, the order is theirs. New ones are created at
  /// the end (max+1), not at 0, so they do not jump to the front.
  order          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  database     GameDatabase      @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  result       GameResult        @relation(fields: [resultId], references: [id])
  source       GameSource        @relation(fields: [sourceId], references: [id])
  orientation  BoardOrientation? @relation(fields: [orientationId], references: [id])
  analysisMode GameAnalysisMode? @relation(fields: [analysisModeId], references: [id])

  classBlocks ClassBlock[]
  positions   GamePosition[]
  /// Lessons that take their content from this game.
  lessons     Lesson[]
  visits      StudyVisit[]
  /// Exercises created from a move of this game («Crear ejercicio desde aquí»).
  exercises   Exercise[]

  @@index([databaseId, order])
}

/// Position index: one row per position the game went through. It is what makes
/// it possible to search "which games got here" by POSITION and not by sequence
/// of moves, so that transpositions count as a match. It is generated on import
/// (see services/game-positions) and regenerated whole if the PGN changes; it is
/// never edited by hand.
///
/// Without a `fen` column on purpose: it is ~80 rows per game and nobody reads
/// the full FEN — whoever searches already brings their own and any ply's can be
/// recovered by replaying the PGN — so it would only bloat the table.
model GamePosition {
  id           String  @id @default(uuid())
  gameId       String
  /// Denormalised from Game: it allows filtering by owner and origin without
  /// joining Game in the explorer's hot query.
  databaseId   String
  /// Half-moves from the start; 0 is the starting position.
  ply          Int
  /// SHA-256 of the normalised FEN (see lib/chess/position-hash).
  positionHash String
  /// Move made FROM this position; null in the last one. The statistics of
  /// continuations come from here.
  nextMoveSan  String?
  nextMoveUci  String?

  game     Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  database GameDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  /// A position repeated in the same game gives several rows, one per ply:
  /// counting games requires counting distinct gameIds, never rows.
  @@unique([gameId, ply])
  @@index([positionHash])
  @@index([positionHash, databaseId])
  @@index([positionHash, nextMoveUci])
}

// ---------------------------------------------------------------------------
// Classes and teachers
// ---------------------------------------------------------------------------

/// Role over User: the teacher panel opens if this row exists.
/// A teacher is never deleted (it would break classes and historical
/// assignments): they are deactivated with isActive, and then they stop being
/// able to enter /teacher and to take new assignments.
model Teacher {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String
  title       String?
  bio         String?
  photo       String?
  timezone    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  classes  Class[]
  students TeacherStudent[]
  /// Collection shares they made.
  shares   StudyShare[]

  /// Their exercises and series, and the series they gave to their students.
  exercises            Exercise[]
  exerciseSeries       ExerciseSeries[]
  exerciseSeriesShares ExerciseSeriesShare[]
}

/// Teacher↔student assignment, independent of the classes: without it a student
/// who does not have classes yet would be invisible to their teacher. endedAt =
/// null ⇒ active. Reassigning CLOSES the row and creates another: the history is
/// never deleted. The "one active teacher per student" rule is imposed by the
/// partial unique index teacher_student_one_active (manual SQL in the
/// migration); to allow several teachers in the future it is enough to remove
/// that index, without touching the model. No status catalog: active/ended is
/// derived from endedAt.
model TeacherStudent {
  id         String    @id @default(uuid())
  teacherId  String
  studentId  String
  assignedAt DateTime  @default(now())
  endedAt    DateTime?
  /// Staff User who made the assignment (lightweight auditing).
  assignedBy String?
  note       String?

  teacher  Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student  User    @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  assigner User?   @relation("AssignmentsMade", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@index([teacherId, endedAt])
  @@index([studentId])
}

/// Administrator/Editor role of the PLATFORM (the row exists = they have the
/// role), the same pattern as Teacher. NOT to be confused with Payload's
/// admin/editor roles, which belong to the public site's CMS and live in another
/// database: they are neither mixed nor reused. If admin and editor are ever
/// separated, a roleId + StaffRole catalog is added here, without touching User.
model Staff {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// What the academy charged a student: an amount for a number of classes. The seats it pays are
/// the participations that point at it (ClassParticipant.paymentId); how many are left is derived
/// on reading (paymentSeats), never stored. Paid classes never expire: there is no expiry column.
/// Written only by registerPayment / updatePayment / deletePayment (services/staff-payments), and
/// by the seed as demo data.
model ClassPayment {
  id           String   @id @default(uuid())
  studentId    String
  /// CHECK class_payment_amount_positive (> 0). The amount is the payment's, never a class's.
  amount       Decimal  @db.Decimal(10, 2)
  currencyId   Int
  /// The day it was paid in the academy's calendar (STUDY_DAY_TIMEZONE); never after today.
  paidOn       DateTime @db.Date
  /// CHECK class_payment_class_count_range (1–50). Never below the seats that count (updatePayment).
  classCount   Int
  reference    String?  @db.VarChar(120)
  /// Internal: only the staff reads it.
  note         String?  @db.VarChar(500)
  /// Null only on the rows the migration made from the old participant columns.
  recordedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student    User               @relation("ClassPaymentStudent", fields: [studentId], references: [id], onDelete: Restrict)
  currency   Currency           @relation(fields: [currencyId], references: [id])
  recordedBy User?              @relation("ClassPaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  seats      ClassParticipant[]

  @@index([studentId, paidOn])
}

/// A live class, given by a teacher to one student or to a group. Its status is what somebody
/// wrote (SCHEDULED, COMPLETED, CANCELLED; an old LIVE row reads as SCHEDULED); the phase it is
/// in is worked out from the clock on every read (classPhase, services/shared/class-phase.ts).
/// A class is never deleted: it is cancelled (transitionClassStatus), and the teacher relation
/// restricts a teacher's deletion so no paid seat ever goes with it.
model Class {
  id                    String    @id @default(uuid())
  /// Set on insert by createClassRecord; changed only by setClassTeacher (staff).
  teacherId             String
  /// Set on insert by createClassRecord; never changed. No DB default.
  formatId              Int
  /// Null in INDIVIDUAL, 2–12 in GROUP. CHECK class_capacity_range; format↔capacity is a service
  /// rule. Set on insert by createClassRecord.
  capacity              Int?
  /// The topic. Null is «Sin tema»: classDisplayTitle supplies «Clase con …» / «Clase de …».
  /// Written by the staff on creation (required in GROUP) and then by the teacher (updateClassTopic).
  title                 String?
  description           String?
  /// Date and time of the class (UTC). CHECK class_duration_positive on durationMin.
  /// scheduledAt and durationMin are computed only by classScheduleColumns and written through it
  /// by createClassRecord / syncClassSchedule (services/shared/class-schedule.service.ts).
  scheduledAt           DateTime
  durationMin           Int
  /// scheduledAt + durationMin, kept so the end can be filtered in SQL. CHECK class_ends_at_derived.
  /// Computed only by classScheduleColumns; written through it by createClassRecord /
  /// syncClassSchedule (services/shared/class-schedule.service.ts).
  endsAt                DateTime
  /// Set to SCHEDULED on insert by createClassRecord (initialClassStatusData); changed only by
  /// transitionClassStatus (services/shared/class-status.service.ts).
  statusId              Int
  /// Deduced from the link by storedMeetingProvider; computed only by classMeetingColumns and
  /// written through it by createClassRecord / syncClassMeeting.
  meetingProviderId     Int?
  /// Staff only. Computed by classMeetingColumns; written by createClassRecord / syncClassMeeting.
  meetingUrl            String?
  /// The instant the staff CHOSE for the link to become visible; null is the default, half an
  /// hour before the class, worked out on reading, so it follows the class when it moves. The link
  /// reaches a student only from that instant. Null without a link: the instant belongs to it.
  /// storedMeetingVisibleFrom, through classMeetingColumns; written by createClassRecord /
  /// syncClassMeeting.
  meetingUrlVisibleFrom DateTime?
  /// Teacher only: finalizeClass / updateClassAfterNotes.
  recordingUrl          String?
  summary               String?   @db.Text
  /// Set on insert by createClassRecord.
  createdById           String?
  /// The last reschedule only. Only writer: syncClassSchedule.
  previousScheduledAt   DateTime?
  rescheduledAt         DateTime?
  rescheduledById       String?
  rescheduleNote        String?   @db.VarChar(300)
  /// Only writer: transitionClassStatus. cancelReason is internal (staff and teacher);
  /// cancelNote is what the students read.
  cancelledAt           DateTime?
  cancelledById         String?
  cancelReason          String?   @db.VarChar(300)
  cancelNote            String?   @db.VarChar(300)
  /// Only writer: transitionClassStatus.
  closedAt              DateTime?
  closedById            String?
  /// Only writer: recordAttendance (services/shared/class-attendance.service.ts).
  attendanceTakenAt     DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  teacher         Teacher          @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  format          ClassFormat      @relation(fields: [formatId], references: [id])
  status          ClassStatus      @relation(fields: [statusId], references: [id])
  meetingProvider MeetingProvider? @relation(fields: [meetingProviderId], references: [id])
  createdBy       User?            @relation("ClassCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  rescheduledBy   User?            @relation("ClassRescheduledBy", fields: [rescheduledById], references: [id], onDelete: SetNull)
  cancelledBy     User?            @relation("ClassCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  closedBy        User?            @relation("ClassClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  participants ClassParticipant[] @relation("ClassParticipants")
  seatsMovedIn ClassParticipant[] @relation("ClassSeatMovedTo")
  blocks       ClassBlock[]
  transcript   ClassTranscript?

  @@index([scheduledAt])
  @@index([teacherId, scheduledAt])
  @@index([statusId, endsAt])
}

/// A seat: a student in a class. Paid (paymentId), free (isFree) or «Sin pago» (neither). The
/// ONE definition of «sin pago» is isUnpaidSeat / unpaidSeatWhere (services/shared/payment-seats.ts).
model ClassParticipant {
  classId            String
  userId             String
  /// The payment this seat spends; null with isFree false is «Sin pago».
  /// Only writer: syncClassSeat (services/shared/class-seats.service.ts).
  paymentId          String?
  /// «Gratis»: charged to nobody, in no balance and no queue. CHECK class_participant_free_has_no_payment.
  /// Set only when the seat is added (syncClassSeat, mode "add"); never changed after.
  isFree             Boolean   @default(false)
  /// Null is «Sin pasar lista». Only writer: recordAttendance.
  attended           Boolean?
  /// Kept, with no writer: reserved for recording the real entry to the call (out of scope).
  joinedAt           DateTime?
  /// Only writer: syncClassSeat.
  addedById          String?
  /// A no-show's seat given another date (or back to its payment) by the staff; the row stays as
  /// history («Faltó · reprogramada»). CHECK class_participant_moved_was_absent.
  /// Only writer: moveClassSeat.
  seatMovedAt        DateTime?
  seatMovedById      String?
  seatMovedToClassId String?
  seatMoveNote       String?   @db.VarChar(300)
  createdAt          DateTime  @default(now())

  class             Class                   @relation("ClassParticipants", fields: [classId], references: [id], onDelete: Cascade)
  user              User                    @relation("ClassParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  payment           ClassPayment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  addedBy           User?                   @relation("ClassParticipantAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  seatMovedBy       User?                   @relation("ClassSeatMovedBy", fields: [seatMovedById], references: [id], onDelete: SetNull)
  seatMovedToClass  Class?                  @relation("ClassSeatMovedTo", fields: [seatMovedToClassId], references: [id], onDelete: SetNull)
  attendanceChanges ClassAttendanceChange[]

  @@id([classId, userId])
  /// "This student's classes" from the teacher and staff panels: the composite key
  /// starts with classId and does not serve that access.
  @@index([userId])
  @@index([paymentId])
}

/// Every attendance mark, the first one included: who marked, when, from what to what and why.
/// Append-only. Only writer: recordAttendance (services/shared/class-attendance.service.ts).
/// The reason is required whenever the staff writes the mark (service rule; D2).
model ClassAttendanceChange {
  id           String   @id @default(uuid())
  classId      String
  userId       String
  fromAttended Boolean?
  toAttended   Boolean
  reason       String?  @db.VarChar(300)
  changedById  String?
  /// A staff change after a report (ADM-9): the teacher sees it with its reason and can no longer
  /// change that student's mark (D3). False for every other mark, the ones the staff writes when
  /// finalizing on the teacher's behalf included.
  isOverride   Boolean  @default(false)
  changedAt    DateTime @default(now())

  participant ClassParticipant @relation(fields: [classId, userId], references: [classId, userId], onDelete: Cascade)
  changedBy   User?            @relation("ClassAttendanceChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([classId, userId, changedAt])
}

/// Ordered content of the class. A block uses the field of its kind and the
/// references are pointers, never copies. CHECK "at most one reference" in the
/// migration. `movePath` uses the same dotted path as TrainingExercise.path.
/// An EXERCISE block (D29) uses none of them: its exercises are its
/// ClassBlockExercise rows.
model ClassBlock {
  id           String   @id @default(uuid())
  classId      String
  order        Int
  kindId       Int
  /// When the block reaches the students (BEFORE, AFTER, TEACHER): the teacher's choice.
  visibilityId Int
  text         String?  @db.Text
  videoUrl     String?
  gameId       String?
  lessonId     String?
  positionId   String?
  movePath     String?
  caption      String?
  /// Game transcribed by the teacher for this class. It lives here and not as a
  /// `Game` because a teacher may have no study at all, and creating one behind
  /// their back just for this would add an entity they did not ask for.
  ///
  /// When there is a PGN here, it RULES over `gameId`: it is this block's game.
  pgn          String?  @db.Text
  /// For the «Nuevo» mark on a block added after the class started (isNewClassBlock).
  createdAt    DateTime @default(now())

  class      Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  kind       ClassBlockKind       @relation(fields: [kindId], references: [id])
  visibility ClassBlockVisibility @relation(fields: [visibilityId], references: [id])
  game       Game?                @relation(fields: [gameId], references: [id], onDelete: SetNull)
  lesson     Lesson?              @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  position   Position?            @relation(fields: [positionId], references: [id], onDelete: SetNull)

  exercises ClassBlockExercise[]
  attempts  TrainingAttempt[]

  @@unique([classId, order])
}

/// The exercises of an EXERCISE block, in order (D29): 1–10, each once, the
/// teacher's own usable ones or the library's (buildPickableExercisesWhere).
/// Written only by the teacher's block actions (addClassBlock /
/// updateClassBlock, services/teacher-classes/teacher-classes.actions.ts,
/// through writeBlockExercises), inside the block's transaction; nobody else
/// touches these rows. Restrict: an exercise a class points at is archived,
/// never deleted.
model ClassBlockExercise {
  blockId    String
  exerciseId String
  order      Int

  block    ClassBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  exercise Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@id([blockId, exerciseId])
  @@unique([blockId, order])
  @@index([exerciseId])
}

model ClassTranscript {
  classId    String   @id
  provider   String?
  language   String?
  statusId   Int
  text       String?  @db.Text
  /// [{ startMs, speaker, text }]
  segments   Json?
  durationMs Int?
  createdAt  DateTime @default(now())

  class  Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  status TranscriptStatus @relation(fields: [statusId], references: [id])
}

/// Saved and reusable diagram. CHECK XOR (userId, courseId) in the migration;
/// TEACHER owners use userId (Teacher is 1:1 with User).
model Position {
  id            String   @id @default(uuid())
  ownerTypeId   Int
  userId        String?
  courseId      String?
  title         String?
  fen           String
  orientationId Int
  /// json of arrows [{ orig, dest, color }]
  arrows        Json?
  /// json of highlighted squares [{ square, color }]
  highlights    Json?
  createdAt     DateTime @default(now())

  ownerType   OwnerType        @relation(fields: [ownerTypeId], references: [id])
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orientation BoardOrientation @relation(fields: [orientationId], references: [id])

  classBlocks ClassBlock[]

  @@index([userId])
  @@index([courseId])
}

// ---------------------------------------------------------------------------
// Activity and statistics
// ---------------------------------------------------------------------------

/// Append-only record of every fact about the student: source of truth of all
/// the statistics. It is never updated nor deleted.
model UserActivity {
  id            String   @id @default(uuid())
  userId        String
  typeId        Int
  subjectTypeId Int
  /// uuid of the subject; polymorphic on purpose, without an FK.
  subjectId     String
  topicId       Int?
  occurredAt    DateTime @default(now())
  meta          Json?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ActivityType @relation(fields: [typeId], references: [id])
  subjectType SubjectType  @relation(fields: [subjectTypeId], references: [id])
  topic       Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
}

/// Aggregate derived per user/day/metric/topic; rebuildable in full from
/// UserActivity. topicId NULL = total. In v1 the dashboard computes directly
/// from UserActivity; this table is ready for the rollup. The unique index is
/// replaced in the migration by NULLS NOT DISTINCT.
model UserStatDaily {
  id       String   @id @default(uuid())
  userId   String
  day      DateTime @db.Date
  metricId Int
  topicId  Int?
  value    Int      @default(0)

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric StatMetric @relation(fields: [metricId], references: [id])
  topic  Topic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([userId, day, metricId, topicId])
}

// ---------------------------------------------------------------------------
// «Jugar»: games played on the platform, against a bot today, a person later
// ---------------------------------------------------------------------------
//
// A played game is NOT a Game: it hangs from no study, so «Mis estudios»,
// the explorer's position index (GamePosition) and the classes never see it,
// and it writes no UserActivity (playing never counts toward the streak).
// «Guardar en un estudio» COPIES it into a Game with source PLATFORM_GAME.
//
// Constraints Prisma cannot express, added by hand in the migration
// `…_played_games` (see there): CHECK bot_elo_range; CHECKs
// played_game_white_one_seat / played_game_black_one_seat (a seat is a person
// OR a bot), played_game_closed_has_termination and played_game_bot_never_rated;
// partial unique indexes played_game_white_user_open_vs_bot and
// played_game_black_user_open_vs_bot (one open game against a bot per person
// and colour).

/// Where a bot belongs (BOT_GROUP, constants/platform/play-codes.const.ts).
/// `ring` is a BotRingCode (NONE, GOLD, TRICOLOR): the portrait's ring as a
/// code, never a colour. Seeded; never edited from the interface.
/// `isListed` is whether the gallery of «Jugar» shows the group (BOT_GROUP_LISTED):
/// false for the one that holds an adventure's rivals (lib/adventure/adventures/*).
/// The gallery omits a hidden group and `startPlayedGame` / `rematchPlayedGame`
/// refuse its bots, so a game against them starts only from the adventure's own
/// action, in the order of its story.
model BotGroup {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  label    String
  ring     String  @default("NONE")
  order    Int     @default(0)
  isListed Boolean @default(true)

  bots Bot[]
}

/// An opponent the engine plays as. Its rows come from ONE place,
/// lib/chess/bots/roster.ts: the seed upserts them and the migrations carry
/// the SQL `npm run bots:sql` generates from it. `elo` is the label the student
/// sees (400–2800, never round; CHECK bot_elo_range); how Stockfish is weakened
/// to it is `strengthFor(elo)` in lib/chess/bots/bot-strength.ts and is never
/// stored. Addressed by `slug` and not by code, as Level is: it goes in the URL.
/// No portrait column: the avatar is initials on a tone derived from the slug.
model Bot {
  id         Int       @id @default(autoincrement())
  slug       String    @unique
  name       String
  elo        Int
  /// One line about how it plays, or who the player is: the academy's own text.
  bio        String
  /// Favourite openings as copy for its card: a list of strings, as Game.tags.
  openings   Json?
  /// Facts about a real player, shown as facts with the date they were true.
  fideElo    Int?
  fideTitle  String?
  /// FIDE's three-letter federation code, for the flag.
  country    String?
  ratingAsOf DateTime? @db.Date
  groupId    Int
  order      Int       @default(0)
  isActive   Boolean   @default(true)

  group      BotGroup     @relation(fields: [groupId], references: [id])
  whiteGames PlayedGame[] @relation("PlayedGameWhiteBot")
  blackGames PlayedGame[] @relation("PlayedGameBlackBot")

  @@index([groupId, order])
}

/// How long each side has (TIME_CONTROL). NONE is the only active one; the
/// eight rhythms of games between people are seeded inactive.
model TimeControl {
  id               Int     @id @default(autoincrement())
  code             String  @unique
  label            String
  /// Null: without a clock.
  initialSeconds   Int?
  incrementSeconds Int     @default(0)
  order            Int     @default(0)
  isActive         Boolean @default(false)

  games PlayedGame[]
}

/// How a played game ended (GAME_TERMINATION). Null while it is being played.
model GameTermination {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  order Int    @default(0)

  games PlayedGame[]
}

/// A game PLAYED on the platform. Two seats, each a person or a bot (exactly
/// one of each pair: CHECKs in the migration); the services require at least
/// one person, and both users set is a game between people.
///
/// SINGLE WRITER: `pgn`, `plyCount`, `finalFen`, `lastMoveAt`, `resultId`,
/// `terminationId` and `finishedAt` are written only by `writePlayedGameRecord`
/// (services/shared/played-game-record.ts), inside the transaction of whoever
/// writes. Nothing deletes a played game; every seat relation is RESTRICT, so
/// the record outlives nobody's history and a future rating can be recomputed
/// from it.
model PlayedGame {
  /// Short: it goes in the URL (/jugar/partidas/aB3xK9pQ), as Game.id.
  id            String    @id @default(nanoid(8))
  whiteUserId   String?
  whiteBotId    Int?
  blackUserId   String?
  blackBotId    Int?
  timeControlId Int
  /// ONGOING («*») while it is played, and after an ABORTED close.
  resultId      Int
  /// Set exactly when the game closes: CHECK played_game_closed_has_termination.
  terminationId Int?
  /// Null when it starts at the initial position (as Game.initialFen).
  initialFen    String?
  /// Moves AND headers: the PGN is the content, as everywhere. Single writer.
  pgn           String    @db.Text
  /// The number of plies in `pgn`: the version each move is checked against. Single writer.
  plyCount      Int       @default(0)
  /// The position after the last move, for the profile's diagram. Single writer.
  finalFen      String
  /// Each seat's strength WHEN it was played: a bot can be recalibrated
  /// afterwards. Written at creation, never updated.
  whiteElo      Int?
  blackElo      Int?
  /// Never true against a bot: CHECK played_game_bot_never_rated.
  isRated       Boolean   @default(false)
  /// Time left per side; null without a clock.
  clockWhiteMs  Int?
  clockBlackMs  Int?
  startedAt     DateTime  @default(now())
  /// Server time of the last move; null before the first. Single writer.
  lastMoveAt    DateTime?
  /// Null while it is played. Single writer.
  finishedAt    DateTime?
  updatedAt     DateTime  @updatedAt

  whiteUser   User?            @relation("PlayedGameWhiteUser", fields: [whiteUserId], references: [id], onDelete: Restrict)
  whiteBot    Bot?             @relation("PlayedGameWhiteBot", fields: [whiteBotId], references: [id], onDelete: Restrict)
  blackUser   User?            @relation("PlayedGameBlackUser", fields: [blackUserId], references: [id], onDelete: Restrict)
  blackBot    Bot?             @relation("PlayedGameBlackBot", fields: [blackBotId], references: [id], onDelete: Restrict)
  timeControl TimeControl      @relation(fields: [timeControlId], references: [id], onDelete: Restrict)
  result      GameResult       @relation(fields: [resultId], references: [id], onDelete: Restrict)
  termination GameTermination? @relation(fields: [terminationId], references: [id], onDelete: Restrict)

  /// The profile's lists.
  @@index([whiteUserId, lastMoveAt])
  @@index([blackUserId, lastMoveAt])
  /// The scoreboard against each bot.
  @@index([whiteUserId, blackBotId])
  @@index([blackUserId, whiteBotId])
  /// A future sweeper of abandoned games, and the clock.
  @@index([lastMoveAt])
  /// The order of a future rating recomputation.
  @@index([finishedAt])
}
