# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# kits de diseño y otros paquetes: fuera del repositorio
*.zip

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma (cliente generado de la plataforma)
/lib/platform-db/generated/

# sitio de documentación (docs/): otra app Next con su propio node_modules
/docs/node_modules/
/docs/.next/
/docs/out/
/docs/public/_pagefind/

# storybook (build estática de `npm run storybook:build`)
/storybook-static/
*storybook.log
