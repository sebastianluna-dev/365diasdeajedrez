# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# design kits and other bundles: out of the repository
*.zip

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma (the platform's generated client)
/lib/platform-db/generated/

# documentation site (docs/): another Next app with its own node_modules
/docs/node_modules/
/docs/.next/
/docs/out/
/docs/public/_pagefind/

# storybook (static build of `npm run storybook:build`)
/storybook-static/
*storybook.log

# working notes: only in the local copy, never on the remote
IMPROVEMENTS.md
TODOS.md
WARNINGS.md
