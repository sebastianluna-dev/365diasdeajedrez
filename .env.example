# Entorno de la app: solo "production" activa Google Analytics y Meta Pixel
NEXT_PUBLIC_APP_ENV=development

# URL pública del sitio, usada por sitemap.xml y robots.txt (sin barra final)
NEXT_PUBLIC_SITE_URL=https://365diasdeajedrez.com

# Google Analytics 4 (Measurement ID, público)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel ID (público)
NEXT_PUBLIC_META_PIXEL_ID=

# Payload CMS
PAYLOAD_SECRET=
DATABASE_URI=

# Cloudinary (nunca expongas CLOUDINARY_API_SECRET al navegador)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Secreto para activar el preview de borradores (/api/preview)
PREVIEW_SECRET=

# Plataforma educativa (Prisma) — base de datos Postgres SEPARADA de Payload.
# El CLI de Prisma la lee vía prisma.config.ts (carga .env.local y .env).
# Usa sslmode=verify-full (igual que DATABASE_URI): con sslmode=require el
# driver pg avisa del cambio de semántica previsto para pg v9.
PLATFORM_DATABASE_URL=

# Contraseña que el seed asigna a las cuentas demo (alumno, profesor y
# administración). Sólo se aplica a cuentas que aún no tienen contraseña: un
# re-seed nunca revierte la que se haya cambiado con `npm run user:password`.
# Por defecto: ajedrez365. Contra una base que NO sea local el seed exige o bien
# una contraseña propia aquí, o bien ALLOW_DEMO_SEED=1 (sólo bases de pruebas).
PLATFORM_DEMO_PASSWORD=
# ALLOW_DEMO_SEED=1
