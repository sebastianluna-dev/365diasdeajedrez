# App environment: only "production" turns on Google Analytics and the Meta Pixel
NEXT_PUBLIC_APP_ENV=development

# Public URL of the site, used by sitemap.xml and robots.txt (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://365diasdeajedrez.com

# Google Analytics 4 (Measurement ID, public)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel ID (public)
NEXT_PUBLIC_META_PIXEL_ID=

# Payload CMS
PAYLOAD_SECRET=
DATABASE_URI=

# Cloudinary (never expose CLOUDINARY_API_SECRET to the browser)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# For development there is a Postgres of both databases in a container:
#   npm run db:up
#   DATABASE_URI=postgres://ajedrez:ajedrez@localhost:5432/payload
#   PLATFORM_DATABASE_URL=postgres://ajedrez:ajedrez@localhost:5432/plataforma
# No sslmode there: the container speaks no TLS. See docs/operations/local-database.

# Learning platform (Prisma) — a Postgres database SEPARATE from Payload's.
# The Prisma CLI reads it through prisma.config.ts (which loads .env.local and .env).
# Use sslmode=verify-full (same as DATABASE_URI): with sslmode=require the pg
# driver warns about the semantics change planned for pg v9.
PLATFORM_DATABASE_URL=

# Password the seed assigns to the demo accounts (student, teacher and staff).
# It only applies to accounts that have no password yet: a re-seed never reverts
# one that was changed with `npm run user:password`.
# Default: ajedrez365. Against a database that is NOT local the seed requires
# either a password of your own here or ALLOW_DEMO_SEED=1 (test databases only).
PLATFORM_DEMO_PASSWORD=
# ALLOW_DEMO_SEED=1

# Pins the seed's reference instant (ISO) so a database can be reproduced byte
# for byte, or a demo prepared days ahead anchored on its day. When unset, today
# at 18:00 UTC.
# SEED_NOW=2026-09-01T18:00:00Z

# PLATFORM_DB_LOG=query prints every query of the platform's database to the
# server's console: how a page's query budget is measured. Unset in production.
# PLATFORM_DB_LOG=query

# Password for `npm run user:create` and `npm run user:password` when it cannot
# be typed (scripts, CI). When missing, they prompt for it without echo.
# PLATFORM_USER_PASSWORD=
